// -----------------------------------------------------------------------------
// Core structure types
// -----------------------------------------------------------------------------

type KBar
    int startIndex
    int endIndex
    int startTime
    int endTime
    float high
    float low
    int highIndex
    int lowIndex
    int highTime
    int lowTime
    int direction

type Fractal
    int kind
    int kPosition
    int structureIndex
    int structureTime
    int confirmationTime
    float price

type Unit
    int layer
    int direction
    int startIndex
    int endIndex
    int startTime
    int endTime
    int confirmationTime
    float startPrice
    float endPrice
    bool confirmed
    int firstChild
    int lastChild
    float macdArea
    float difExtreme
    float rangeHigh
    float rangeLow

type Feature
    int firstChild
    int lastChild
    float high
    float low
    int highIndex
    int lowIndex
    int highTime
    int lowTime
    int highChild
    int lowChild
    int direction

