f_copy_kbar(KBar source) =>
    KBar.new(source.startIndex, source.endIndex, source.startTime, source.endTime, source.high, source.low, source.highIndex, source.lowIndex, source.highTime, source.lowTime, source.direction)

f_copy_fractal(Fractal source) =>
    Fractal.new(source.kind, source.kPosition, source.structureIndex, source.structureTime, source.confirmationTime, source.price)

f_copy_unit(Unit source) =>
    Unit.new(source.layer, source.direction, source.startIndex, source.endIndex, source.startTime, source.endTime, source.confirmationTime, source.startPrice, source.endPrice, source.confirmed, source.firstChild, source.lastChild, source.macdArea, source.difExtreme, source.rangeHigh, source.rangeLow)

// 预览路径只会追加元素或修改各数组的最后一个对象，因此浅拷贝共享已确认
// 对象，仅深拷贝可变尾部；这是隔离候选副本所需的最小拷贝量。
f_tail_isolated_kbars(array<KBar> source) =>
    array<KBar> result = array.copy(source)
    int count = array.size(result)
    if count > 0
        array.set(result, count - 1, f_copy_kbar(array.get(result, count - 1)))
    result

f_tail_isolated_units(array<Unit> source) =>
    array<Unit> result = array.copy(source)
    int count = array.size(result)
    if count > 0
        array.set(result, count - 1, f_copy_unit(array.get(result, count - 1)))
    result

f_copy_kbars(array<KBar> source) =>
    array<KBar> result = array.new<KBar>()
    int count = array.size(source)
    if count > 0
        for i = 0 to count - 1
            array.push(result, f_copy_kbar(array.get(source, i)))
    result

f_copy_fractals(array<Fractal> source) =>
    array<Fractal> result = array.new<Fractal>()
    int count = array.size(source)
    if count > 0
        for i = 0 to count - 1
            array.push(result, f_copy_fractal(array.get(source, i)))
    result

f_copy_units(array<Unit> source) =>
    array<Unit> result = array.new<Unit>()
    int count = array.size(source)
    if count > 0
        for i = 0 to count - 1
            array.push(result, f_copy_unit(array.get(source, i)))
    result

f_new_reference_engine() =>
    ReferenceEngine.new(ReferenceState.new(false, 0, na, 0, na, false), array.new<KBar>(), array.new<Fractal>(), array.new<Unit>(), array.new<Unit>(), array.new<Unit>(), array.new<Unit>(), array.new<Unit>(), array.new<float>(), array.new<float>(), array.new<int>(), array.new<int>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<Center>(), array.new<Center>(), array.new<Center>(), array.new<Divergence>(), array.new<Divergence>(), array.new<Divergence>(), array.new<BuySellPoint>(), array.new<BuySellPoint>(), array.new<BuySellPoint>(), na, na, na)

f_next_reference_seconds(int seconds) =>
    seconds < 60 ? 60 : seconds < 300 ? 300 : seconds < 900 ? 900 : seconds < 3600 ? 3600 : seconds < 14400 ? 14400 : seconds < 86400 ? 86400 : seconds < 604800 ? 604800 : seconds < 2592000 ? 2592000 : seconds < 7776000 ? 7776000 : seconds < 31536000 ? 31536000 : 0

f_timeframe_from_seconds(int seconds) =>
    seconds == 60 ? "1" : seconds == 300 ? "5" : seconds == 900 ? "15" : seconds == 3600 ? "60" : seconds == 14400 ? "240" : seconds == 86400 ? "1D" : seconds == 604800 ? "1W" : seconds == 2592000 ? "1M" : seconds == 7776000 ? "3M" : seconds == 31536000 ? "12M" : ""

f_auto_reference_timeframe(int position) =>
    int seconds = int(timeframe.in_seconds())
    for i = 1 to position
        seconds := f_next_reference_seconds(seconds)
    f_timeframe_from_seconds(seconds)

f_reference_source() =>
    [referenceDif, referenceSignal, referenceHist] = ta.macd(math.round_to_mintick(close), 12, 26, 9)
    [time[1], math.round_to_mintick(high[1]), math.round_to_mintick(low[1]), referenceDif[1], referenceHist[1]]

f_contains(float firstHigh, float firstLow, float secondHigh, float secondLow) =>
    (firstHigh >= secondHigh and firstLow <= secondLow) or (secondHigh >= firstHigh and secondLow <= firstLow)

f_relation(float previousHigh, float previousLow, float currentHigh, float currentLow) =>
    currentHigh > previousHigh and currentLow > previousLow ? 1 : currentHigh < previousHigh and currentLow < previousLow ? -1 : 0

f_seed_direction(array<float> pendingHighs, array<float> pendingLows) =>
    int result = 0
    int pendingSize = array.size(pendingHighs)
    if pendingSize >= 2
        float clusterHigh = array.get(pendingHighs, 0)
        float clusterLow = array.get(pendingLows, 0)
        for i = 1 to pendingSize - 1
            float nextHigh = array.get(pendingHighs, i)
            float nextLow = array.get(pendingLows, i)
            if not f_contains(clusterHigh, clusterLow, nextHigh, nextLow)
                result := f_relation(clusterHigh, clusterLow, nextHigh, nextLow)
                if result != 0
                    break
            else
                clusterHigh := math.max(clusterHigh, nextHigh)
                clusterLow := math.min(clusterLow, nextLow)
    result

f_ingest_kbar(array<KBar> bars, float rawHigh, float rawLow, int rawIndex, int rawTime, int forcedDirection) =>
    bool appended = false
    int count = array.size(bars)
    if count == 0
        array.push(bars, KBar.new(rawIndex, rawIndex, rawTime, rawTime, rawHigh, rawLow, rawIndex, rawIndex, rawTime, rawTime, forcedDirection))
        appended := true
    else
        KBar lastBar = array.get(bars, count - 1)
        int direction = forcedDirection
        if count >= 2
            KBar previousBar = array.get(bars, count - 2)
            int inferred = f_relation(previousBar.high, previousBar.low, lastBar.high, lastBar.low)
            direction := inferred != 0 ? inferred : lastBar.direction
        else if lastBar.direction != 0
            direction := lastBar.direction
        if f_contains(lastBar.high, lastBar.low, rawHigh, rawLow)
            direction := direction == 0 ? forcedDirection : direction
            if direction >= 0
                if rawHigh >= lastBar.high
                    lastBar.high := rawHigh
                    lastBar.highIndex := rawIndex
                    lastBar.highTime := rawTime
                if rawLow >= lastBar.low
                    lastBar.low := rawLow
                    lastBar.lowIndex := rawIndex
                    lastBar.lowTime := rawTime
            else
                if rawHigh <= lastBar.high
                    lastBar.high := rawHigh
                    lastBar.highIndex := rawIndex
                    lastBar.highTime := rawTime
                if rawLow <= lastBar.low
                    lastBar.low := rawLow
                    lastBar.lowIndex := rawIndex
                    lastBar.lowTime := rawTime
            lastBar.endIndex := rawIndex
            lastBar.endTime := rawTime
            lastBar.direction := direction
            array.set(bars, count - 1, lastBar)
        else
            int nextDirection = f_relation(lastBar.high, lastBar.low, rawHigh, rawLow)
            array.push(bars, KBar.new(rawIndex, rawIndex, rawTime, rawTime, rawHigh, rawLow, rawIndex, rawIndex, rawTime, rawTime, nextDirection))
            appended := true
    appended

f_detect_confirmed_fractal(array<KBar> bars, int confirmationTime) =>
    Fractal result = na
    int count = array.size(bars)
    if count >= 3
        int middlePosition = count - 2
        KBar leftBar = array.get(bars, middlePosition - 1)
        KBar middleBar = array.get(bars, middlePosition)
        KBar rightBar = array.get(bars, middlePosition + 1)
        bool isTop = middleBar.high > leftBar.high and middleBar.high > rightBar.high and middleBar.low > leftBar.low and middleBar.low > rightBar.low
        bool isBottom = middleBar.low < leftBar.low and middleBar.low < rightBar.low and middleBar.high < leftBar.high and middleBar.high < rightBar.high
        if isTop
            result := Fractal.new(1, middlePosition, middleBar.highIndex, middleBar.highTime, confirmationTime, middleBar.high)
        else if isBottom
            result := Fractal.new(-1, middlePosition, middleBar.lowIndex, middleBar.lowTime, confirmationTime, middleBar.low)
    result

// MACD 同向柱体面积使用前缀和：摄入时累积正/负柱体绝对值，
// 任意区间面积由两次查表相减得到，避免每次结构重建按区间循环。
f_push_macd_cums(array<float> posAreaCums, array<float> negAreaCums, float histValue) =>
    int count = array.size(posAreaCums)
    float previousPos = count > 0 ? array.get(posAreaCums, count - 1) : 0.0
    float previousNeg = count > 0 ? array.get(negAreaCums, count - 1) : 0.0
    float positivePart = na(histValue) or histValue <= 0 ? 0.0 : histValue
    float negativePart = na(histValue) or histValue >= 0 ? 0.0 : -histValue
    array.push(posAreaCums, previousPos + positivePart)
    array.push(negAreaCums, previousNeg + negativePart)

f_unit_macd_area(array<float> posAreaCums, array<float> negAreaCums, int startIndex, int endIndex, int direction) =>
    array<float> cums = direction == 1 ? posAreaCums : negAreaCums
    int firstIndex = math.max(0, math.min(startIndex, endIndex))
    int lastIndex = math.min(array.size(cums) - 1, math.max(startIndex, endIndex))
    lastIndex >= firstIndex ? array.get(cums, lastIndex) - (firstIndex > 0 ? array.get(cums, firstIndex - 1) : 0.0) : 0.0

f_unit_dif_extreme(array<float> difValues, int startIndex, int endIndex, int direction) =>
    float extreme = na
    int firstIndex = math.max(0, math.min(startIndex, endIndex))
    int lastIndex = math.min(array.size(difValues) - 1, math.max(startIndex, endIndex))
    if lastIndex >= firstIndex
        for i = firstIndex to lastIndex
            float value = array.get(difValues, i)
            if not na(value)
                extreme := na(extreme) ? value : direction == 1 ? math.max(extreme, value) : math.min(extreme, value)
    extreme

f_apply_unit_strength(Unit unit, array<float> posAreaCums, array<float> negAreaCums, array<float> difValues) =>
    unit.macdArea := f_unit_macd_area(posAreaCums, negAreaCums, unit.startIndex, unit.endIndex, unit.direction)
    unit.difExtreme := f_unit_dif_extreme(difValues, unit.startIndex, unit.endIndex, unit.direction)
    unit

f_update_strokes(array<Fractal> endpoints, array<Unit> strokes, Fractal newFractal, array<float> posAreaCums, array<float> negAreaCums, array<float> difValues, bool allowConfirmation) =>
    bool changed = false
    int endpointCount = array.size(endpoints)
    if endpointCount == 0
        array.push(endpoints, newFractal)
        changed := true
    else
        Fractal lastEndpoint = array.get(endpoints, endpointCount - 1)
        if newFractal.kind == lastEndpoint.kind
            bool moreExtreme = newFractal.kind == 1 ? newFractal.price > lastEndpoint.price : newFractal.price < lastEndpoint.price
            bool equalAndLater = newFractal.price == lastEndpoint.price and newFractal.structureTime >= lastEndpoint.structureTime
            if moreExtreme or equalAndLater
                // 候选延伸只移动末端候选，不改变任何已确认前缀，因此不标记
                // 结构变化：历史回放只在新笔或确认边界处重建，末端候选的
                // 最终状态由下一个结构事件或活动 K 线全量重建覆盖。这是
                // 免费计划 20 秒计算预算下保留确认真实性的裁剪 (ADR 0047)。
                array.set(endpoints, endpointCount - 1, newFractal)
                int strokeCount = array.size(strokes)
                if strokeCount > 0
                    Unit lastStroke = array.get(strokes, strokeCount - 1)
                    if not lastStroke.confirmed
                        lastStroke.endIndex := newFractal.structureIndex
                        lastStroke.endTime := newFractal.structureTime
                        lastStroke.endPrice := newFractal.price
                        lastStroke.rangeHigh := math.max(lastStroke.startPrice, lastStroke.endPrice)
                        lastStroke.rangeLow := math.min(lastStroke.startPrice, lastStroke.endPrice)
                        lastStroke := f_apply_unit_strength(lastStroke, posAreaCums, negAreaCums, difValues)
                        array.set(strokes, strokeCount - 1, lastStroke)
        else
            bool enoughSyntheticBars = math.abs(newFractal.kPosition - lastEndpoint.kPosition) >= 3
            bool enoughRawBars = math.abs(newFractal.structureIndex - lastEndpoint.structureIndex) >= 4
            if enoughSyntheticBars and enoughRawBars
                int strokeCount = array.size(strokes)
                if strokeCount > 0 and allowConfirmation
                    Unit previousStroke = array.get(strokes, strokeCount - 1)
                    previousStroke.confirmed := true
                    previousStroke.confirmationTime := newFractal.confirmationTime
                    array.set(strokes, strokeCount - 1, previousStroke)
                int direction = lastEndpoint.kind == -1 ? 1 : -1
                Unit nextStroke = Unit.new(0, direction, lastEndpoint.structureIndex, newFractal.structureIndex, lastEndpoint.structureTime, newFractal.structureTime, na, lastEndpoint.price, newFractal.price, false, lastEndpoint.kPosition, newFractal.kPosition, na, na, math.max(lastEndpoint.price, newFractal.price), math.min(lastEndpoint.price, newFractal.price))
                nextStroke := f_apply_unit_strength(nextStroke, posAreaCums, negAreaCums, difValues)
                array.push(strokes, nextStroke)
                array.push(endpoints, newFractal)
                changed := true
    changed

f_extend_terminal_candidate(array<Unit> strokes, int sourceIndex, int sourceTime, float sourceHigh, float sourceLow, array<float> posAreaCums, array<float> negAreaCums, array<float> difValues) =>
    int strokeCount = array.size(strokes)
    if strokeCount > 0
        Unit terminal = array.get(strokes, strokeCount - 1)
        if not terminal.confirmed
            bool extends = terminal.direction == 1 ? sourceHigh >= terminal.endPrice : sourceLow <= terminal.endPrice
            if extends
                terminal.endIndex := sourceIndex
                terminal.endTime := sourceTime
                terminal.endPrice := terminal.direction == 1 ? sourceHigh : sourceLow
                terminal.rangeHigh := math.max(terminal.startPrice, terminal.endPrice)
                terminal.rangeLow := math.min(terminal.startPrice, terminal.endPrice)
                terminal := f_apply_unit_strength(terminal, posAreaCums, negAreaCums, difValues)
                array.set(strokes, strokeCount - 1, terminal)

f_unit_high(Unit unit) =>
    na(unit.rangeHigh) ? math.max(unit.startPrice, unit.endPrice) : unit.rangeHigh

f_unit_low(Unit unit) =>
    na(unit.rangeLow) ? math.min(unit.startPrice, unit.endPrice) : unit.rangeLow

f_children_range_high(array<Unit> units, int firstChild, int lastChild) =>
    float result = na
    if firstChild >= 0 and lastChild >= firstChild and lastChild < array.size(units)
        for childIndex = firstChild to lastChild
            float childHigh = f_unit_high(array.get(units, childIndex))
            result := na(result) ? childHigh : math.max(result, childHigh)
    result

f_children_range_low(array<Unit> units, int firstChild, int lastChild) =>
    float result = na
    if firstChild >= 0 and lastChild >= firstChild and lastChild < array.size(units)
        for childIndex = firstChild to lastChild
            float childLow = f_unit_low(array.get(units, childIndex))
            result := na(result) ? childLow : math.min(result, childLow)
    result

f_feature_from_unit(Unit unit, int childIndex, int direction) =>
    bool highAtStart = unit.startPrice >= unit.endPrice
    bool lowAtStart = unit.startPrice <= unit.endPrice
    Feature.new(childIndex, childIndex, f_unit_high(unit), f_unit_low(unit), highAtStart ? unit.startIndex : unit.endIndex, lowAtStart ? unit.startIndex : unit.endIndex, highAtStart ? unit.startTime : unit.endTime, lowAtStart ? unit.startTime : unit.endTime, childIndex, childIndex, direction)

f_feature_relation(Feature previous, Feature current) =>
    current.high > previous.high and current.low > previous.low ? 1 : current.high < previous.high and current.low < previous.low ? -1 : 0

f_ingest_feature(array<Feature> features, Unit unit, int childIndex, int forcedDirection) =>
    Feature incoming = f_feature_from_unit(unit, childIndex, forcedDirection)
    int count = array.size(features)
    if count == 0
        array.push(features, incoming)
    else
        Feature last = array.get(features, count - 1)
        bool contained = f_contains(last.high, last.low, incoming.high, incoming.low)
        if contained
            int direction = forcedDirection
            if count >= 2
                Feature previous = array.get(features, count - 2)
                int inferred = f_feature_relation(previous, last)
                direction := inferred != 0 ? inferred : last.direction
            else if last.direction != 0
                direction := last.direction
            if direction >= 0
                if incoming.high >= last.high
                    last.high := incoming.high
                    last.highIndex := incoming.highIndex
                    last.highTime := incoming.highTime
                    last.highChild := incoming.highChild
                if incoming.low >= last.low
                    last.low := incoming.low
                    last.lowIndex := incoming.lowIndex
                    last.lowTime := incoming.lowTime
                    last.lowChild := incoming.lowChild
            else
                if incoming.high <= last.high
                    last.high := incoming.high
                    last.highIndex := incoming.highIndex
                    last.highTime := incoming.highTime
                    last.highChild := incoming.highChild
                if incoming.low <= last.low
                    last.low := incoming.low
                    last.lowIndex := incoming.lowIndex
                    last.lowTime := incoming.lowTime
                    last.lowChild := incoming.lowChild
            last.lastChild := childIndex
            last.direction := direction
            array.set(features, count - 1, last)
        else
            incoming.direction := f_feature_relation(last, incoming)
            array.push(features, incoming)

f_feature_is_pivot(Feature left, Feature middle, Feature right, int segmentDirection) =>
    segmentDirection == 1 ? middle.high > left.high and middle.high > right.high and middle.low > left.low and middle.low > right.low : middle.low < left.low and middle.low < right.low and middle.high < left.high and middle.high < right.high

f_reverse_feature_confirmed(array<Unit> lowerUnits, int startChild, int reverseDirection) =>
    bool confirmed = false
    int lowerCount = array.size(lowerUnits)
    array<Feature> reverseFeatures = array.new<Feature>()
    if startChild + 1 < lowerCount
        for i = startChild + 1 to lowerCount - 1
            Unit child = array.get(lowerUnits, i)
            if child.direction == -reverseDirection
                f_ingest_feature(reverseFeatures, child, i, reverseDirection)
                int featureCount = array.size(reverseFeatures)
                if featureCount >= 3
                    Feature left = array.get(reverseFeatures, featureCount - 3)
                    Feature middle = array.get(reverseFeatures, featureCount - 2)
                    Feature right = array.get(reverseFeatures, featureCount - 1)
                    if f_feature_is_pivot(left, middle, right, reverseDirection)
                        Unit proof = array.get(lowerUnits, right.lastChild)
                        confirmed := proof.confirmed
                        break
    confirmed

f_build_recursive_layer(array<Unit> lowerUnits, array<Unit> outputUnits, int layer, array<float> posAreaCums, array<float> negAreaCums, array<float> difValues) =>
    array.clear(outputUnits)
    int lowerCount = array.size(lowerUnits)
    int startChild = 0
    bool search = lowerCount >= 3
    while search and startChild + 2 < lowerCount
        Unit startUnit = array.get(lowerUnits, startChild)
        int segmentDirection = startUnit.direction
        array<Feature> features = array.new<Feature>()
        bool foundBreak = false
        int endpointChild = na
        int proofChild = na
        if startChild + 1 < lowerCount
            for i = startChild + 1 to lowerCount - 1
                Unit child = array.get(lowerUnits, i)
                if child.direction == -segmentDirection
                    f_ingest_feature(features, child, i, segmentDirection)
                    int featureCount = array.size(features)
                    if featureCount >= 3
                        Feature left = array.get(features, featureCount - 3)
                        Feature middle = array.get(features, featureCount - 2)
                        Feature right = array.get(features, featureCount - 1)
                        if f_feature_is_pivot(left, middle, right, segmentDirection)
                            int possibleEndpoint = segmentDirection == 1 ? middle.highChild : middle.lowChild
                            bool enoughChildren = possibleEndpoint - startChild >= 3
                            bool hasGap = segmentDirection == 1 ? middle.low > left.high : middle.high < left.low
                            Unit directProof = array.get(lowerUnits, right.lastChild)
                            bool proofConfirmed = directProof.confirmed
                            bool reverseConfirmed = hasGap ? f_reverse_feature_confirmed(lowerUnits, possibleEndpoint, -segmentDirection) : true
                            if enoughChildren and proofConfirmed and reverseConfirmed
                                endpointChild := possibleEndpoint
                                proofChild := right.lastChild
                                foundBreak := true
                                break
        if foundBreak
            Unit boundary = array.get(lowerUnits, endpointChild)
            Unit proof = array.get(lowerUnits, proofChild)
            int confirmationTime = na(proof.confirmationTime) ? proof.endTime : proof.confirmationTime
            float segmentHigh = f_children_range_high(lowerUnits, startChild, endpointChild - 1)
            float segmentLow = f_children_range_low(lowerUnits, startChild, endpointChild - 1)
            Unit confirmedUnit = Unit.new(layer, segmentDirection, startUnit.startIndex, boundary.startIndex, startUnit.startTime, boundary.startTime, confirmationTime, startUnit.startPrice, boundary.startPrice, true, startChild, endpointChild - 1, na, na, segmentHigh, segmentLow)
            confirmedUnit := f_apply_unit_strength(confirmedUnit, posAreaCums, negAreaCums, difValues)
            array.push(outputUnits, confirmedUnit)
            startChild := endpointChild
        else
            search := false

    int remaining = lowerCount - startChild
    if remaining >= 3
        Unit candidateStart = array.get(lowerUnits, startChild)
        int candidateDirection = candidateStart.direction
        float extremePrice = candidateStart.startPrice
        int extremeIndex = candidateStart.startIndex
        int extremeTime = candidateStart.startTime
        for i = startChild to lowerCount - 1
            Unit child = array.get(lowerUnits, i)
            float childHigh = f_unit_high(child)
            float childLow = f_unit_low(child)
            if candidateDirection == 1 and childHigh >= extremePrice
                extremePrice := childHigh
                bool highAtStart = child.startPrice >= child.endPrice
                extremeIndex := highAtStart ? child.startIndex : child.endIndex
                extremeTime := highAtStart ? child.startTime : child.endTime
            else if candidateDirection == -1 and childLow <= extremePrice
                extremePrice := childLow
                bool lowAtStart = child.startPrice <= child.endPrice
                extremeIndex := lowAtStart ? child.startIndex : child.endIndex
                extremeTime := lowAtStart ? child.startTime : child.endTime
        float candidateHigh = f_children_range_high(lowerUnits, startChild, lowerCount - 1)
        float candidateLow = f_children_range_low(lowerUnits, startChild, lowerCount - 1)
        Unit candidateUnit = Unit.new(layer, candidateDirection, candidateStart.startIndex, extremeIndex, candidateStart.startTime, extremeTime, na, candidateStart.startPrice, extremePrice, false, startChild, lowerCount - 1, na, na, candidateHigh, candidateLow)
        candidateUnit := f_apply_unit_strength(candidateUnit, posAreaCums, negAreaCums, difValues)
        array.push(outputUnits, candidateUnit)

f_unit_overlaps_center(Unit unit, float zd, float zg) =>
    math.max(f_unit_low(unit), zd) < math.min(f_unit_high(unit), zg)

// 离开判定是方向相关的：真实离开段起点在核心内部，整段区间必然与核心
// 保持重叠，因此不能用“整段脱离核心”判据——那会把随后的反向回试误认成
// 离开段。改用方向端点越过对应核心边界。
f_unit_cross_side(Unit unit, float zd, float zg) =>
    unit.direction == 1 and f_unit_high(unit) > zg ? 1 : unit.direction == -1 and f_unit_low(unit) < zd ? -1 : 0

// 回试端点保持在核心外侧（向上离开时不低于 ZG，向下离开时不高于 ZD）。
f_retest_holds_outside(Unit retest, int leaveDirection, float zd, float zg) =>
    leaveDirection == 1 ? f_unit_low(retest) >= zg : f_unit_high(retest) <= zd

f_has_reliable_confirmed_center(array<Unit> units, int warmupBars) =>
    bool found = false
    int unitCount = array.size(units)
    if unitCount >= 3
        for startChild = 0 to unitCount - 3
            Unit first = array.get(units, startChild)
            Unit second = array.get(units, startChild + 1)
            Unit third = array.get(units, startChild + 2)
            bool sourcesAfterWarmup = first.startIndex >= warmupBars
            bool sourcesConfirmed = first.confirmed and second.confirmed and third.confirmed
            bool alternating = first.direction != second.direction and second.direction != third.direction and first.direction == third.direction
            float zd = math.max(f_unit_low(first), math.max(f_unit_low(second), f_unit_low(third)))
            float zg = math.min(f_unit_high(first), math.min(f_unit_high(second), f_unit_high(third)))
            if sourcesAfterWarmup and sourcesConfirmed and alternating and zd < zg
                found := true
                break
    found

f_center_relation(Center previous, Center current) =>
    current.dd > previous.gg ? 1 : current.gg < previous.dd ? -1 : 0

f_create_center(array<Unit> units, int layer, int startChild) =>
    Center result = na
    int unitCount = array.size(units)
    if startChild + 2 < unitCount
        Unit first = array.get(units, startChild)
        Unit second = array.get(units, startChild + 1)
        Unit third = array.get(units, startChild + 2)
        bool alternating = first.direction != second.direction and second.direction != third.direction and first.direction == third.direction
        float zd = math.max(f_unit_low(first), math.max(f_unit_low(second), f_unit_low(third)))
        float zg = math.min(f_unit_high(first), math.min(f_unit_high(second), f_unit_high(third)))
        if alternating and zd < zg
            float dd = math.min(f_unit_low(first), math.min(f_unit_low(second), f_unit_low(third)))
            float gg = math.max(f_unit_high(first), math.max(f_unit_high(second), f_unit_high(third)))
            bool coreConfirmed = first.confirmed and second.confirmed and third.confirmed
            int coreConfirmationTime = coreConfirmed ? (na(third.confirmationTime) ? third.endTime : third.confirmationTime) : na
            Center newCenter = Center.new(layer, startChild, startChild + 2, startChild + 2, first.startIndex, third.endIndex, first.startTime, third.endTime, coreConfirmationTime, na, zd, zg, dd, gg, coreConfirmed, coreConfirmed, 0, 0, na, na, false, 0, na, na, false, false, na, na, na, na, na, na, na)
            if startChild + 3 < unitCount
                // 方向感知口径：方向端点越过对应核心边界的同向单元是离开候选，
                // 单元交替保证紧随其后的反向单元就是回试段。
                for i = startChild + 3 to unitCount - 1
                    Unit current = array.get(units, i)
                    if newCenter.leaveState == 0
                        int side = f_unit_cross_side(current, newCenter.zd, newCenter.zg)
                        if side != 0
                            newCenter.leaveState := 1
                            newCenter.leaveDirection := side
                            newCenter.leaveChild := i
                            newCenter.endChild := i
                            newCenter.endIndex := current.endIndex
                            newCenter.endTime := current.endTime
                            newCenter.stateConfirmed := false
                        else
                            newCenter.stateConfirmed := newCenter.stateConfirmed and current.confirmed
                            if f_unit_overlaps_center(current, newCenter.zd, newCenter.zg)
                                newCenter.dd := math.min(newCenter.dd, f_unit_low(current))
                                newCenter.gg := math.max(newCenter.gg, f_unit_high(current))
                                newCenter.lastOverlapChild := i
                            newCenter.endChild := i
                            newCenter.endIndex := current.endIndex
                            newCenter.endTime := current.endTime
                    else
                        Unit leaving = array.get(units, newCenter.leaveChild)
                        bool holdsOutside = f_retest_holds_outside(current, newCenter.leaveDirection, newCenter.zd, newCenter.zg)
                        if holdsOutside
                            newCenter.retestChild := i
                            newCenter.endChild := i
                            newCenter.endIndex := current.endIndex
                            newCenter.endTime := current.endTime
                            if leaving.confirmed and current.confirmed
                                newCenter.leaveState := 2
                                newCenter.departureConfirmationTime := na(current.confirmationTime) ? current.endTime : current.confirmationTime
                                newCenter.stateConfirmed := true
                            else
                                newCenter.stateConfirmed := false
                            break
                        else
                            // 回试重返核心：离开失败，两段并入波动区间后继续延伸。
                            newCenter.dd := math.min(newCenter.dd, math.min(f_unit_low(leaving), f_unit_low(current)))
                            newCenter.gg := math.max(newCenter.gg, math.max(f_unit_high(leaving), f_unit_high(current)))
                            newCenter.failedDeparture := true
                            newCenter.failedLeaveDirection := newCenter.leaveDirection
                            newCenter.failedLeaveChild := newCenter.leaveChild
                            newCenter.failedRetestChild := i
                            newCenter.stateConfirmed := newCenter.confirmed and leaving.confirmed and current.confirmed
                            newCenter.lastOverlapChild := i
                            newCenter.endChild := i
                            newCenter.endIndex := current.endIndex
                            newCenter.endTime := current.endTime
                            newCenter.leaveState := 0
                            newCenter.leaveDirection := 0
                            newCenter.leaveChild := na
                            newCenter.retestChild := na
                            int reverseSide = f_unit_cross_side(current, newCenter.zd, newCenter.zg)
                            if reverseSide != 0
                                newCenter.leaveState := 1
                                newCenter.leaveDirection := reverseSide
                                newCenter.leaveChild := i
                                newCenter.stateConfirmed := false
            result := newCenter
    result

f_build_centers(array<Unit> units, array<Center> centers, int layer) =>
    array.clear(centers)
    int unitCount = array.size(units)
    int cursor = 0
    bool searching = unitCount >= 3
    while searching and cursor + 2 < unitCount
        Center nextCenter = f_create_center(units, layer, cursor)
        if not na(nextCenter)
            array.push(centers, nextCenter)
            if nextCenter.leaveState == 2
                cursor := math.max(cursor + 1, nextCenter.leaveChild)
            else
                searching := false
        else
            cursor += 1

    int centerCount = array.size(centers)
    if centerCount >= 2
        for i = 1 to centerCount - 1
            Center previous = array.get(centers, i - 1)
            Center current = array.get(centers, i)
            bool coreOverlap = math.max(previous.zd, current.zd) < math.min(previous.zg, current.zg)
            bool coreTouches = math.max(previous.zd, current.zd) == math.min(previous.zg, current.zg)
            bool volatilityOverlap = math.max(previous.dd, current.dd) < math.min(previous.gg, current.gg)
            if not coreOverlap and not coreTouches and volatilityOverlap
                current.expansionCandidate := true
                array.set(centers, i, current)

f_link_center_promotions(array<Center> lowerCenters, array<Center> higherCenters, array<Unit> higherComponents) =>
    int lowerCount = array.size(lowerCenters)
    int higherCount = array.size(higherCenters)
    if lowerCount > 0 and higherCount > 0
        for lowerIndex = 0 to lowerCount - 1
            Center current = array.get(lowerCenters, lowerIndex)
            for higherIndex = 0 to higherCount - 1
                Center parent = array.get(higherCenters, higherIndex)
                bool containsSources = parent.startTime <= current.startTime and parent.endTime >= current.endTime
                bool hasThreeConfirmedSources = parent.confirmed and parent.lastOverlapChild >= parent.startChild + 2
                int lowerComponentCount = 0
                if hasThreeConfirmedSources and parent.startChild + 2 < array.size(higherComponents)
                    for sourceIndex = parent.startChild to parent.startChild + 2
                        Unit source = array.get(higherComponents, sourceIndex)
                        lowerComponentCount += math.max(0, source.lastChild - source.firstChild + 1)
                bool hasNineLowerComponents = lowerComponentCount >= 9
                if hasThreeConfirmedSources and hasNineLowerComponents and containsSources
                    Unit promotionProof = array.get(higherComponents, parent.startChild + 2)
                    current.expansionConfirmed := true
                    current.parentCenter := higherIndex
                    current.promotionSourceFirst := parent.startChild
                    current.promotionSourceSecond := parent.startChild + 1
                    current.promotionSourceThird := parent.startChild + 2
                    current.promotionConfirmationIndex := promotionProof.endIndex
                    current.promotionConfirmationTime := na(parent.confirmationTime) ? (na(promotionProof.confirmationTime) ? promotionProof.endTime : promotionProof.confirmationTime) : parent.confirmationTime
                    current.promotionConfirmationPrice := promotionProof.endPrice
                    // promotion_does_not_bootstrap_parent_components: the parent
                    // was already built only from independently completed movements.
                    array.set(lowerCenters, lowerIndex, current)
                    break

f_is_qualified_reverse_component(Unit proof, int trendLevel, int movementDirection) =>
    int expectedLayer = trendLevel - 1
    bool expectedLevel = proof.layer == expectedLayer
    bool completeBaseSegment = trendLevel > 0 or proof.lastChild - proof.firstChild + 1 >= 3
    proof.confirmed and proof.direction == -movementDirection and expectedLevel and completeBaseSegment

f_previous_divergence_known(array<Divergence> previous, int layer, int kind, int direction, int structureTime) =>
    int result = time
    int previousCount = array.size(previous)
    if previousCount > 0
        for previousIndex = 0 to previousCount - 1
            Divergence candidate = array.get(previous, previousIndex)
            bool sameIdentity = candidate.layer == layer and candidate.kind == kind and candidate.direction == direction and candidate.structureTime == structureTime
            if sameIdentity
                result := candidate.firstKnownTime
                break
    result

f_build_divergences(array<Unit> units, array<Center> centers, array<Divergence> divergences, int layer, int warmupBars) =>
    array<Divergence> previousDivergences = array.copy(divergences)
    array.clear(divergences)
    int centerCount = array.size(centers)
    if centerCount > 0
        for centerIndex = 0 to centerCount - 1
            Center currentCenter = array.get(centers, centerIndex)
            bool activeDeparture = currentCenter.leaveState > 0 and currentCenter.leaveDirection != 0 and not na(currentCenter.leaveChild)
            bool confirmedFailedDeparture = currentCenter.failedDeparture and currentCenter.stateConfirmed and currentCenter.failedLeaveDirection != 0 and not na(currentCenter.failedLeaveChild) and not na(currentCenter.failedRetestChild)
            bool hasDeparture = currentCenter.confirmed and (activeDeparture or confirmedFailedDeparture)
            if hasDeparture
                int departureDirection = activeDeparture ? currentCenter.leaveDirection : currentCenter.failedLeaveDirection
                int departureChild = activeDeparture ? currentCenter.leaveChild : currentCenter.failedLeaveChild
                int trendCenterCount = 1
                int trendDirection = 0
                if centerIndex >= 1
                    for relationIndex = centerIndex to 1
                        Center relationPrevious = array.get(centers, relationIndex - 1)
                        Center relationCurrent = array.get(centers, relationIndex)
                        int relation = f_center_relation(relationPrevious, relationCurrent)
                        if trendDirection == 0 and relation != 0
                            trendDirection := relation
                            trendCenterCount := 2
                        else if relation == trendDirection and relation != 0
                            trendCenterCount += 1
                        else
                            break
                bool departureMatchesStructure = trendCenterCount == 1 or trendDirection == departureDirection
                int divergenceKind = trendCenterCount >= 2 ? 2 : 1
                int comparisonCenter = divergenceKind == 2 ? centerIndex - 1 : na
                int firstTrendCenter = math.max(0, centerIndex - trendCenterCount + 1)
                Center trendStartCenter = array.get(centers, firstTrendCenter)
                int enteringIndex = na
                if currentCenter.startChild > 0
                    for unitIndex = currentCenter.startChild - 1 to 0
                        Unit possibleEntering = array.get(units, unitIndex)
                        if possibleEntering.direction == departureDirection
                            enteringIndex := unitIndex
                            break
                int firstEnteringIndex = na
                int comparisonStartChild = divergenceKind == 2 and comparisonCenter >= 0 ? array.get(centers, comparisonCenter).startChild : trendStartCenter.startChild
                if comparisonStartChild > 0
                    for unitIndex = comparisonStartChild - 1 to 0
                        Unit possibleFirstEntering = array.get(units, unitIndex)
                        if possibleFirstEntering.direction == departureDirection
                            firstEnteringIndex := unitIndex
                            break

                bool confirmedThirdPoint = false
                int thirdPointIndex = na
                if activeDeparture and currentCenter.leaveState == 2 and not na(currentCenter.retestChild)
                    Unit retest = array.get(units, currentCenter.retestChild)
                    bool reverseRetest = retest.direction == -departureDirection
                    bool outsideCore = departureDirection == 1 ? f_unit_low(retest) >= currentCenter.zg : f_unit_high(retest) <= currentCenter.zd
                    confirmedThirdPoint := reverseRetest and outsideCore and retest.confirmed
                    thirdPointIndex := confirmedThirdPoint ? currentCenter.retestChild : na

                int leavingIndex = departureChild
                if divergenceKind == 2
                    int possibleLeavingIndex = na(thirdPointIndex) ? na : thirdPointIndex + 1
                    if not na(possibleLeavingIndex) and possibleLeavingIndex < array.size(units)
                        Unit possibleLeaving = array.get(units, possibleLeavingIndex)
                        if possibleLeaving.direction == departureDirection
                            leavingIndex := possibleLeavingIndex
                        else
                            leavingIndex := na
                    else
                        leavingIndex := na

                bool traceableTrend = divergenceKind == 1 or (comparisonCenter >= 0 and not na(firstEnteringIndex) and confirmedThirdPoint and not na(leavingIndex))
                if departureMatchesStructure and not na(enteringIndex) and not na(leavingIndex) and traceableTrend
                    Unit entering = array.get(units, enteringIndex)
                    Unit leaving = array.get(units, leavingIndex)
                    bool weakerArea = entering.macdArea > 0 and leaving.macdArea < entering.macdArea
                    bool reliable = entering.startIndex >= warmupBars
                    if weakerArea and reliable
                        float previousExtreme = na
                        if leavingIndex > trendStartCenter.startChild
                            for extremeIndex = trendStartCenter.startChild to leavingIndex - 1
                                Unit extremeUnit = array.get(units, extremeIndex)
                                float extremeValue = departureDirection == 1 ? f_unit_high(extremeUnit) : f_unit_low(extremeUnit)
                                previousExtreme := na(previousExtreme) ? extremeValue : departureDirection == 1 ? math.max(previousExtreme, extremeValue) : math.min(previousExtreme, extremeValue)
                        bool newTrendExtreme = na(previousExtreme) or (departureDirection == 1 ? f_unit_high(leaving) > previousExtreme : f_unit_low(leaving) < previousExtreme)
                        bool structureEligible = divergenceKind == 2 ? newTrendExtreme : true
                        bool divergenceConfirmed = leaving.confirmed
                        float structurePrice = leaving.endPrice
                        int structureIndex = leaving.endIndex
                        int structureTime = leaving.endTime
                        float confirmationPrice = divergenceConfirmed ? leaving.endPrice : na
                        float areaRatio = entering.macdArea > 0 ? leaving.macdArea / entering.macdArea : na
                        bool difWeaker = departureDirection == 1 ? leaving.difExtreme < entering.difExtreme : leaving.difExtreme > entering.difExtreme
                        int divergenceConfirmationTime = divergenceConfirmed ? (na(leaving.confirmationTime) ? leaving.endTime : leaving.confirmationTime) : na
                        int evidenceStartTime = divergenceConfirmed ? divergenceConfirmationTime : structureTime
                        int firstKnownTime = f_previous_divergence_known(previousDivergences, layer, divergenceKind, departureDirection, structureTime)
                        if structureEligible
                            array.push(divergences, Divergence.new(layer, divergenceKind, departureDirection, centerIndex, comparisonCenter, trendCenterCount, firstEnteringIndex, enteringIndex, leavingIndex, thirdPointIndex, structureIndex, structureTime, divergenceConfirmationTime, firstKnownTime, structurePrice, confirmationPrice, divergenceConfirmed, areaRatio, entering.macdArea, leaving.macdArea, difWeaker, true, false, structurePrice, evidenceStartTime, na, leaving.startTime, leaving.endTime))

    int divergenceCount = array.size(divergences)
    if divergenceCount > 0
        for divergenceIndex = 0 to divergenceCount - 1
            Divergence current = array.get(divergences, divergenceIndex)
            bool endpointFrozenByReverse = false
            int completionProofIndex = current.leavingUnit + 1
            if completionProofIndex < array.size(units)
                Unit completionProof = array.get(units, completionProofIndex)
                endpointFrozenByReverse := f_is_qualified_reverse_component(completionProof, layer, current.direction)
            if current.confirmed and not endpointFrozenByReverse
                int scanFrom = current.leavingUnit + 1
                if current.centerIndex < array.size(centers)
                    Center sourceCenter = array.get(centers, current.centerIndex)
                    scanFrom := na(sourceCenter.retestChild) ? scanFrom : math.max(scanFrom, sourceCenter.retestChild + 1)
                if scanFrom < array.size(units)
                    for unitIndex = scanFrom to array.size(units) - 1
                        Unit currentUnit = array.get(units, unitIndex)
                        bool continuesPastExtreme = current.direction == 1 ? f_unit_high(currentUnit) > current.invalidationPrice : f_unit_low(currentUnit) < current.invalidationPrice
                        if continuesPastExtreme
                            if currentUnit.confirmed
                                current.valid := false
                                current.evidenceEndTime := na(currentUnit.confirmationTime) ? currentUnit.endTime : currentUnit.confirmationTime
                                break
                            else
                                current.invalidationCandidate := true
                array.set(divergences, divergenceIndex, current)

f_build_completed_movements(array<Unit> components, array<Center> centers, array<Divergence> divergences, array<Unit> movements, int trendLevel, array<float> posAreaCums, array<float> negAreaCums, array<float> difValues) =>
    array.clear(movements)
    int nextFirstComponent = 0
    int previousDirection = 0
    int divergenceCount = array.size(divergences)
    if divergenceCount > 0
        for divergenceIndex = 0 to divergenceCount - 1
            Divergence divergence = array.get(divergences, divergenceIndex)
            if divergence.confirmed and divergence.valid and divergence.centerIndex >= 0 and divergence.centerIndex < array.size(centers)
                Center sourceCenter = array.get(centers, divergence.centerIndex)
                int enteringComponent = divergence.kind == 2 and not na(divergence.firstEnteringUnit) ? divergence.firstEnteringUnit : divergence.enteringUnit
                int firstCenterChild = sourceCenter.startChild
                if divergence.kind == 2 and divergence.comparisonCenter >= 0 and divergence.comparisonCenter < array.size(centers)
                    firstCenterChild := array.get(centers, divergence.comparisonCenter).startChild
                int naturalFirstComponent = math.max(0, math.min(enteringComponent, firstCenterChild))
                int firstComponent = array.size(movements) == 0 ? naturalFirstComponent : nextFirstComponent
                int lastComponent = divergence.leavingUnit
                int proofComponent = lastComponent + 1
                bool directionAlternates = previousDirection == 0 or divergence.direction == -previousDirection
                bool sourceInsideMovement = firstCenterChild >= firstComponent and sourceCenter.startChild + 2 <= lastComponent
                bool hasReverseProof = proofComponent < array.size(components)
                if hasReverseProof
                    Unit proof = array.get(components, proofComponent)
                    hasReverseProof := f_is_qualified_reverse_component(proof, trendLevel, divergence.direction)
                if directionAlternates and sourceInsideMovement and hasReverseProof and lastComponent >= firstComponent and lastComponent < array.size(components)
                    Unit first = array.get(components, firstComponent)
                    Unit last = array.get(components, lastComponent)
                    Unit proof = array.get(components, proofComponent)
                    float movementHigh = f_children_range_high(components, firstComponent, lastComponent)
                    float movementLow = f_children_range_low(components, firstComponent, lastComponent)
                    int completionTime = na(proof.confirmationTime) ? proof.endTime : proof.confirmationTime
                    Unit movement = Unit.new(trendLevel, divergence.direction, first.startIndex, last.endIndex, first.startTime, last.endTime, completionTime, first.startPrice, last.endPrice, true, firstComponent, lastComponent, na, na, movementHigh, movementLow)
                    movement := f_apply_unit_strength(movement, posAreaCums, negAreaCums, difValues)
                    array.push(movements, movement)
                    nextFirstComponent := proofComponent
                    previousDirection := divergence.direction

f_get_trend_state(array<Center> centers, array<Divergence> divergences, array<Unit> completedMovements, int layer) =>
    int centerCount = array.size(centers)
    int kind = 0
    int direction = 0
    int sequenceCount = 0
    int firstCenter = na
    int lastCenter = na
    bool confirmed = false
    bool completionCandidate = false
    int completionProof = 0
    int status = 0
    if centerCount > 0
        kind := 1
        sequenceCount := 1
        firstCenter := centerCount - 1
        lastCenter := centerCount - 1
        Center last = array.get(centers, lastCenter)
        direction := last.leaveDirection != 0 ? last.leaveDirection : last.failedDeparture ? last.failedLeaveDirection : 0
        status := last.confirmed ? MOVEMENT_QUALIFIED : MOVEMENT_FORMING
        if centerCount >= 2
            int sequenceDirection = 0
            for i = 1 to centerCount - 1
                Center previous = array.get(centers, i - 1)
                Center current = array.get(centers, i)
                int relation = f_center_relation(previous, current)
                if relation != 0
                    if relation == sequenceDirection
                        sequenceCount += 1
                    else
                        sequenceDirection := relation
                        sequenceCount := 2
                        firstCenter := i - 1
                    direction := relation
                    lastCenter := i
                else
                    sequenceDirection := 0
                    sequenceCount := 1
                    firstCenter := i
                    lastCenter := i
                    direction := current.leaveDirection != 0 ? current.leaveDirection : current.failedDeparture ? current.failedLeaveDirection : 0
            kind := sequenceCount >= 2 ? 2 : 1
        int divergenceCount = array.size(divergences)
        if divergenceCount > 0
            Divergence latest = array.get(divergences, divergenceCount - 1)
            bool divergenceMatchesMovement = latest.kind == kind and latest.direction == direction
            completionCandidate := latest.centerIndex == lastCenter and latest.valid and divergenceMatchesMovement
            if completionCandidate
                status := MOVEMENT_COMPLETION_CANDIDATE
                int movementCount = array.size(completedMovements)
                if movementCount > 0
                    Unit latestCompleted = array.get(completedMovements, movementCount - 1)
                    if latestCompleted.endTime == latest.structureTime and latestCompleted.direction == latest.direction
                        status := MOVEMENT_COMPLETED
                        completionProof := MOVEMENT_COMPLETED_BY_REVERSE
                Center sourceCenter = array.get(centers, latest.centerIndex)
                bool promotionCompletes = latest.confirmed and sourceCenter.expansionConfirmed and not na(sourceCenter.promotionConfirmationTime) and sourceCenter.promotionConfirmationTime >= latest.confirmationTime
                if status != MOVEMENT_COMPLETED and promotionCompletes
                    status := MOVEMENT_COMPLETED
                    completionProof := MOVEMENT_COMPLETED_BY_PROMOTION
        confirmed := status == MOVEMENT_COMPLETED
    TrendState.new(layer, kind, direction, sequenceCount, firstCenter, lastCenter, status, confirmed, completionCandidate, completionProof)

f_unit_confirmation_time(Unit unit) =>
    na(unit.confirmationTime) ? unit.endTime : unit.confirmationTime

f_completed_movement_index(array<Unit> movements, Divergence divergence) =>
    int result = na
    int movementCount = array.size(movements)
    if movementCount > 0
        for movementIndex = 0 to movementCount - 1
            Unit movement = array.get(movements, movementIndex)
            if movement.direction == divergence.direction and movement.endTime == divergence.structureTime
                result := movementIndex
                break
    result

f_previous_point_known(array<BuySellPoint> previous, int layer, int pointClass, int direction, int structureTime) =>
    int result = time
    int previousCount = array.size(previous)
    if previousCount > 0
        for previousIndex = 0 to previousCount - 1
            BuySellPoint candidate = array.get(previous, previousIndex)
            bool sameIdentity = candidate.layer == layer and candidate.pointClass == pointClass and candidate.direction == direction and candidate.structureTime == structureTime
            if sameIdentity
                result := candidate.firstKnownTime
                break
    result

f_build_points(array<Unit> units, array<Center> centers, array<Divergence> divergences, array<Unit> completedMovements, array<BuySellPoint> lowerPoints, array<BuySellPoint> points, int layer) =>
    array<BuySellPoint> previousPoints = array.copy(points)
    array.clear(points)
    int unitCount = array.size(units)
    int divergenceCount = array.size(divergences)

    if divergenceCount > 0
        for divergenceIndex = 0 to divergenceCount - 1
            Divergence current = array.get(divergences, divergenceIndex)
            if current.kind == 2 and current.valid
                int pointDirection = -current.direction
                Center sourceCenter = array.get(centers, current.centerIndex)
                int completedMovementIndex = f_completed_movement_index(completedMovements, current)
                bool completedByReverse = not na(completedMovementIndex)
                bool completedByPromotion = current.confirmed and sourceCenter.expansionConfirmed and not na(sourceCenter.promotionConfirmationTime) and sourceCenter.promotionConfirmationTime >= current.confirmationTime
                bool pointConfirmed = completedByReverse or completedByPromotion
                int proofIndex = completedByReverse and current.leavingUnit + 1 < unitCount ? current.leavingUnit + 1 : na
                int evidenceStartIndex = current.structureIndex
                int evidenceStartTime = current.structureTime
                int delayBars = na
                int pointConfirmationTime = na
                float pointConfirmationPrice = na
                if pointConfirmed and not na(proofIndex)
                    Unit proof = array.get(units, proofIndex)
                    evidenceStartIndex := proof.endIndex
                    evidenceStartTime := f_unit_confirmation_time(proof)
                    delayBars := math.max(0, proof.endIndex - current.structureIndex)
                    pointConfirmationTime := f_unit_confirmation_time(proof)
                    pointConfirmationPrice := proof.endPrice
                else if completedByPromotion
                    evidenceStartIndex := sourceCenter.promotionConfirmationIndex
                    evidenceStartTime := sourceCenter.promotionConfirmationTime
                    delayBars := math.max(0, sourceCenter.promotionConfirmationIndex - current.structureIndex)
                    pointConfirmationTime := sourceCenter.promotionConfirmationTime
                    pointConfirmationPrice := sourceCenter.promotionConfirmationPrice
                int firstKnownTime = f_previous_point_known(previousPoints, layer, 1, pointDirection, current.structureTime)
                array.push(points, BuySellPoint.new(layer, 1, pointDirection, layer, divergenceIndex, current.centerIndex, na, 0, current.leavingUnit, proofIndex, current.structureIndex, current.structureTime, pointConfirmationTime, firstKnownTime, current.structurePrice, pointConfirmationPrice, delayBars, pointConfirmed, true, false, current.structurePrice, evidenceStartIndex, evidenceStartTime, na, na))

    int firstPointCount = array.size(points)
    if firstPointCount > 0
        for firstPointIndex = 0 to firstPointCount - 1
            BuySellPoint firstPoint = array.get(points, firstPointIndex)
            if firstPoint.confirmed
                int reverseIndex = firstPoint.structureUnit + 1
                int pullbackIndex = firstPoint.structureUnit + 2
                if pullbackIndex < unitCount
                    Unit reverseAdvance = array.get(units, reverseIndex)
                    Unit pullback = array.get(units, pullbackIndex)
                    bool correctSequence = reverseAdvance.direction == firstPoint.direction and pullback.direction == -firstPoint.direction
                    if correctSequence
                        bool pointConfirmed = pullback.confirmed
                        int pointConfirmationTime = pointConfirmed ? f_unit_confirmation_time(pullback) : na
                        float pointConfirmationPrice = pointConfirmed ? pullback.endPrice : na
                        int evidenceStartIndex = pullback.endIndex
                        int evidenceStartTime = pointConfirmed ? pointConfirmationTime : pullback.endTime
                        int delayBars = pointConfirmed ? math.max(0, pullback.endIndex - firstPoint.structureIndex) : na
                        float relativePrice = pullback.endPrice
                        int relativePosition = relativePrice == firstPoint.structurePrice ? 0 : firstPoint.direction == 1 ? (relativePrice > firstPoint.structurePrice ? 1 : -1) : (relativePrice < firstPoint.structurePrice ? 1 : -1)
                        int firstKnownTime = f_previous_point_known(previousPoints, layer, 2, firstPoint.direction, pullback.endTime)
                        array.push(points, BuySellPoint.new(layer, 2, firstPoint.direction, layer, firstPoint.sourceDivergence, firstPoint.sourceCenter, firstPointIndex, relativePosition, pullbackIndex, pullbackIndex, pullback.endIndex, pullback.endTime, pointConfirmationTime, firstKnownTime, pullback.endPrice, pointConfirmationPrice, delayBars, pointConfirmed, true, false, pullback.endPrice, evidenceStartIndex, evidenceStartTime, na, na))

    int lowerPointCount = array.size(lowerPoints)
    if layer > 0 and lowerPointCount > 0
        for lowerPointIndex = 0 to lowerPointCount - 1
            BuySellPoint lowerFirst = array.get(lowerPoints, lowerPointIndex)
            if lowerFirst.pointClass == 1 and lowerFirst.confirmed and lowerFirst.valid
                int advanceIndex = na
                if unitCount > 0
                    for unitIndex = 0 to unitCount - 1
                        Unit possibleAdvance = array.get(units, unitIndex)
                        bool startsAfterFirstPoint = possibleAdvance.startTime >= lowerFirst.structureTime
                        bool knownAfterFirstPoint = f_unit_confirmation_time(possibleAdvance) >= lowerFirst.confirmationTime
                        if na(advanceIndex) and possibleAdvance.direction == lowerFirst.direction and startsAfterFirstPoint and knownAfterFirstPoint
                            advanceIndex := unitIndex
                int pullbackIndex = na(advanceIndex) ? na : advanceIndex + 1
                if not na(pullbackIndex) and pullbackIndex < unitCount
                    Unit pullback = array.get(units, pullbackIndex)
                    bool correctSequence = pullback.direction == -lowerFirst.direction
                    bool duplicate = false
                    int currentPointCount = array.size(points)
                    if currentPointCount > 0
                        for pointIndex = 0 to currentPointCount - 1
                            BuySellPoint existing = array.get(points, pointIndex)
                            if existing.pointClass == 2 and existing.direction == lowerFirst.direction and existing.structureTime == pullback.endTime
                                duplicate := true
                                break
                    if correctSequence and not duplicate
                        bool pointConfirmed = pullback.confirmed
                        int pointConfirmationTime = pointConfirmed ? f_unit_confirmation_time(pullback) : na
                        float pointConfirmationPrice = pointConfirmed ? pullback.endPrice : na
                        int delayBars = pointConfirmed ? math.max(0, pullback.endIndex - lowerFirst.structureIndex) : na
                        int relativePosition = pullback.endPrice == lowerFirst.structurePrice ? 0 : lowerFirst.direction == 1 ? (pullback.endPrice > lowerFirst.structurePrice ? 1 : -1) : (pullback.endPrice < lowerFirst.structurePrice ? 1 : -1)
                        int firstKnownTime = f_previous_point_known(previousPoints, layer, 2, lowerFirst.direction, pullback.endTime)
                        array.push(points, BuySellPoint.new(layer, 2, lowerFirst.direction, lowerFirst.layer, lowerFirst.sourceDivergence, lowerFirst.sourceCenter, lowerPointIndex, relativePosition, pullbackIndex, pullbackIndex, pullback.endIndex, pullback.endTime, pointConfirmationTime, firstKnownTime, pullback.endPrice, pointConfirmationPrice, delayBars, pointConfirmed, true, false, pullback.endPrice, pullback.endIndex, pointConfirmed ? pointConfirmationTime : pullback.endTime, na, na))

    int centerCount = array.size(centers)
    if centerCount > 0
        for centerIndex = 0 to centerCount - 1
            Center currentCenter = array.get(centers, centerIndex)
            if currentCenter.confirmed and not na(currentCenter.retestChild) and currentCenter.leaveDirection != 0
                Unit retest = array.get(units, currentCenter.retestChild)
                bool outsideCore = currentCenter.leaveDirection == 1 ? f_unit_low(retest) >= currentCenter.zg : f_unit_high(retest) <= currentCenter.zd
                if outsideCore
                    bool pointConfirmed = currentCenter.leaveState == 2 and retest.confirmed
                    int pointConfirmationTime = pointConfirmed ? f_unit_confirmation_time(retest) : na
                    float pointConfirmationPrice = pointConfirmed ? retest.endPrice : na
                    int evidenceStartIndex = retest.endIndex
                    int evidenceStartTime = pointConfirmed ? pointConfirmationTime : retest.endTime
                    int delayBars = pointConfirmed ? math.max(0, retest.endIndex - array.get(units, currentCenter.leaveChild).startIndex) : na
                    float invalidationPrice = currentCenter.leaveDirection == 1 ? currentCenter.zg : currentCenter.zd
                    int firstKnownTime = f_previous_point_known(previousPoints, layer, 3, currentCenter.leaveDirection, retest.endTime)
                    array.push(points, BuySellPoint.new(layer, 3, currentCenter.leaveDirection, layer, na, centerIndex, na, 0, currentCenter.retestChild, currentCenter.retestChild, retest.endIndex, retest.endTime, pointConfirmationTime, firstKnownTime, retest.endPrice, pointConfirmationPrice, delayBars, pointConfirmed, true, false, invalidationPrice, evidenceStartIndex, evidenceStartTime, na, na))

    int pointCount = array.size(points)
    if pointCount > 0
        for pointIndex = 0 to pointCount - 1
            BuySellPoint currentPoint = array.get(points, pointIndex)
            if currentPoint.confirmed
                if currentPoint.pointClass == 2
                    int movementCount = array.size(completedMovements)
                    if movementCount > 0
                        for movementIndex = 0 to movementCount - 1
                            Unit breakMovement = array.get(completedMovements, movementIndex)
                            bool completedOpposingMovement = breakMovement.confirmed and breakMovement.direction == -currentPoint.direction and breakMovement.startTime >= currentPoint.structureTime
                            if completedOpposingMovement
                                currentPoint.valid := false
                                currentPoint.evidenceEndIndex := breakMovement.endIndex
                                currentPoint.evidenceEndTime := f_unit_confirmation_time(breakMovement)
                                break
                else
                    int scanFrom = na(currentPoint.proofUnit) ? currentPoint.structureUnit + 1 : currentPoint.proofUnit + 1
                    if scanFrom < unitCount
                        for unitIndex = scanFrom to unitCount - 1
                            Unit currentUnit = array.get(units, unitIndex)
                            bool violates = false
                            if currentPoint.pointClass == 3 and currentPoint.sourceCenter < array.size(centers)
                                Center sourceCenter = array.get(centers, currentPoint.sourceCenter)
                                violates := f_unit_overlaps_center(currentUnit, sourceCenter.zd, sourceCenter.zg)
                            else if not na(currentPoint.invalidationPrice)
                                violates := currentPoint.direction == 1 ? f_unit_low(currentUnit) < currentPoint.invalidationPrice : f_unit_high(currentUnit) > currentPoint.invalidationPrice
                            if violates
                                if currentUnit.confirmed
                                    currentPoint.valid := false
                                    currentPoint.evidenceEndIndex := currentUnit.endIndex
                                    currentPoint.evidenceEndTime := f_unit_confirmation_time(currentUnit)
                                    break
                                else
                                    currentPoint.invalidationCandidate := true
                array.set(points, pointIndex, currentPoint)

f_event_prefix(string marketTimeframe) =>
    syminfo.tickerid + "|TF=" + marketTimeframe + "|theory=" + THEORY_VERSION

f_event_id(string marketTimeframe, int layer, string eventType, int direction, int structureTime) =>
    f_event_prefix(marketTimeframe) + "|T" + str.tostring(layer) + "|" + eventType + "|" + str.tostring(direction) + "|" + str.tostring(structureTime)

f_movement_context_id(string marketTimeframe, int layer, int structureTime) =>
    "center_defined|TF=" + marketTimeframe + "|T" + str.tostring(layer) + "|anchor=" + str.tostring(structureTime)

f_evidence_short(Evidence evidence) =>
    string kindText = evidence.kind == 1 ? "盘背" : evidence.kind == 2 ? "趋背" : evidence.kind == 11 ? "1点" : evidence.kind == 12 ? "2点" : "3点"
    evidence.marketTimeframe + "·T" + str.tostring(evidence.layer) + "·" + kindText

f_structure_level_id(string structureKind, int layer) =>
    structureKind == "fractal" ? "F" : structureKind == "stroke" ? "B" : structureKind == "segment" ? "S" : "T" + str.tostring(layer)

f_snapshot_id(string marketTimeframe, string structureKind, int layer, int direction, int structureTime, int endTime) =>
    f_event_prefix(marketTimeframe) + "|" + f_structure_level_id(structureKind, layer) + "|" + structureKind + "|" + str.tostring(direction) + "|" + str.tostring(structureTime) + "|" + str.tostring(endTime)

f_fractal_structure_id(string marketTimeframe, Fractal fractal) =>
    f_snapshot_id(marketTimeframe, "fractal", -2, fractal.kind, fractal.structureTime, fractal.structureTime)

f_unit_structure_id(string marketTimeframe, string structureKind, int layer, Unit unit) =>
    f_snapshot_id(marketTimeframe, structureKind, layer, unit.direction, unit.startTime, unit.endTime)

f_center_structure_id(string marketTimeframe, Center center, array<Unit> sourceUnits, int layer) =>
    int sourceStartTime = center.startTime
    int sourceEndTime = center.confirmationTime
    bool hasStableSources = center.startChild >= 0 and center.startChild + 2 < array.size(sourceUnits)
    if hasStableSources
        sourceStartTime := array.get(sourceUnits, center.startChild).startTime
        sourceEndTime := array.get(sourceUnits, center.startChild + 2).endTime
    f_snapshot_id(marketTimeframe, "center", layer, 0, sourceStartTime, sourceEndTime)

f_divergence_structure_id(string marketTimeframe, Divergence divergence) =>
    string kind = divergence.kind == 2 ? "trend_divergence" : "consolidation_divergence"
    f_snapshot_id(marketTimeframe, kind, divergence.layer, divergence.direction, divergence.parentStartTime, divergence.structureTime)

f_point_structure_id(string marketTimeframe, BuySellPoint point) =>
    string kind = "point_" + str.tostring(point.pointClass)
    f_snapshot_id(marketTimeframe, kind, point.layer, point.direction, point.structureTime, point.structureTime)

f_indexed_unit_structure_id(string marketTimeframe, array<Unit> units, int unitIndex, string structureKind, int layer) =>
    string result = "na"
    if not na(unitIndex) and unitIndex >= 0 and unitIndex < array.size(units)
        result := f_unit_structure_id(marketTimeframe, structureKind, layer, array.get(units, unitIndex))
    result

f_add_structure_snapshot(array<StructureSnapshot> snapshots, string marketTimeframe, string slotId, string structureKind, int layer, string structureId, string state, int structureTime, int knownTime, string sourceId, string reason) =>
    array.push(snapshots, StructureSnapshot.new(marketTimeframe, slotId, structureKind, layer, structureId, state, structureTime, knownTime, sourceId, reason))

f_collect_fractal_snapshots(array<StructureSnapshot> snapshots, string marketTimeframe, array<Fractal> endpoints) =>
    int count = array.size(endpoints)
    if count > 0
        for i = 0 to count - 1
            Fractal current = array.get(endpoints, i)
            bool terminal = i == count - 1
            string structureId = f_fractal_structure_id(marketTimeframe, current)
            string state = terminal ? "candidate" : "confirmed"
            string sourceId = "raw_time=" + str.tostring(current.structureTime) + "|kind=" + str.tostring(current.kind) + "|price=" + str.tostring(current.price)
            f_add_structure_snapshot(snapshots, marketTimeframe, structureId, "fractal", -2, structureId, state, current.structureTime, current.confirmationTime, sourceId, terminal ? "terminal_endpoint" : "alternating_endpoint_frozen")

f_collect_stroke_snapshots(array<StructureSnapshot> snapshots, string marketTimeframe, array<Unit> strokes, array<Fractal> endpoints) =>
    int count = array.size(strokes)
    if count > 0
        for i = 0 to count - 1
            Unit current = array.get(strokes, i)
            string structureId = f_unit_structure_id(marketTimeframe, "stroke", -2, current)
            string state = current.confirmed ? "confirmed" : "candidate"
            int knownTime = current.confirmed ? (na(current.confirmationTime) ? current.endTime : current.confirmationTime) : time
            string sourceId = "start=na|end=na"
            if i + 1 < array.size(endpoints)
                sourceId := "start=" + f_fractal_structure_id(marketTimeframe, array.get(endpoints, i)) + "|end=" + f_fractal_structure_id(marketTimeframe, array.get(endpoints, i + 1))
            f_add_structure_snapshot(snapshots, marketTimeframe, structureId, "stroke", -2, structureId, state, current.endTime, knownTime, sourceId, current.confirmed ? "boundary_frozen" : "terminal_preview")

f_collect_unit_snapshots(array<StructureSnapshot> snapshots, string marketTimeframe, array<Unit> units, string structureKind, int layer, array<Unit> sourceUnits, string sourceKind, int sourceLayer) =>
    int count = array.size(units)
    if count > 0
        for i = 0 to count - 1
            Unit current = array.get(units, i)
            string structureId = f_unit_structure_id(marketTimeframe, structureKind, layer, current)
            string state = current.confirmed ? "confirmed" : "candidate"
            int knownTime = current.confirmed ? (na(current.confirmationTime) ? current.endTime : current.confirmationTime) : time
            string sourceId = "first=" + f_indexed_unit_structure_id(marketTimeframe, sourceUnits, current.firstChild, sourceKind, sourceLayer) + "|last=" + f_indexed_unit_structure_id(marketTimeframe, sourceUnits, current.lastChild, sourceKind, sourceLayer)
            f_add_structure_snapshot(snapshots, marketTimeframe, structureId, structureKind, layer, structureId, state, current.endTime, knownTime, sourceId, current.confirmed ? "boundary_frozen" : "terminal_preview")

f_collect_center_snapshots(array<StructureSnapshot> snapshots, string marketTimeframe, array<Center> centers, array<Unit> sourceUnits, int layer) =>
    int count = array.size(centers)
    if count > 0
        for i = 0 to count - 1
            Center current = array.get(centers, i)
            string sourceKind = layer == 0 ? "segment" : "movement"
            int sourceLayer = layer - 1
            string structureId = f_center_structure_id(marketTimeframe, current, sourceUnits, layer)
            string state = current.confirmed ? "confirmed" : "candidate"
            int knownTime = current.confirmed ? current.confirmationTime : time
            string sourceId = "first=" + f_indexed_unit_structure_id(marketTimeframe, sourceUnits, current.startChild, sourceKind, sourceLayer) + "|third=" + f_indexed_unit_structure_id(marketTimeframe, sourceUnits, current.startChild + 2, sourceKind, sourceLayer) + "|last=" + f_indexed_unit_structure_id(marketTimeframe, sourceUnits, current.endChild, sourceKind, sourceLayer)
            f_add_structure_snapshot(snapshots, marketTimeframe, structureId, "center", layer, structureId, state, current.endTime, knownTime, sourceId, current.confirmed ? "three_component_overlap" : "candidate_uses_unconfirmed_component")

f_collect_trend_snapshot(array<StructureSnapshot> snapshots, string marketTimeframe, TrendState trend, array<Center> centers, array<Unit> sourceUnits, int layer) =>
    if not na(trend) and trend.kind > 0 and trend.firstCenter >= 0 and trend.lastCenter < array.size(centers)
        Center first = array.get(centers, trend.firstCenter)
        Center last = array.get(centers, trend.lastCenter)
        string structureId = f_snapshot_id(marketTimeframe, "trend_state", layer, trend.direction, first.startTime, last.endTime)
        string state = trend.status == MOVEMENT_COMPLETED ? "confirmed" : "candidate"
        string reason = trend.status == MOVEMENT_COMPLETED and trend.completionProof == MOVEMENT_COMPLETED_BY_PROMOTION ? "movement_completed_by_level_promotion" : trend.status == MOVEMENT_COMPLETED ? "movement_completed_by_reverse_component" : trend.status == MOVEMENT_COMPLETION_CANDIDATE ? "divergence_completion_candidate" : trend.status == MOVEMENT_QUALIFIED ? "movement_qualified" : "movement_forming"
        int knownTime = trend.completionProof == MOVEMENT_COMPLETED_BY_PROMOTION ? last.promotionConfirmationTime : time
        string sourceId = "first=" + f_center_structure_id(marketTimeframe, first, sourceUnits, layer) + "|last=" + f_center_structure_id(marketTimeframe, last, sourceUnits, layer) + "|completion_proof=" + str.tostring(trend.completionProof)
        f_add_structure_snapshot(snapshots, marketTimeframe, f_event_prefix(marketTimeframe) + "|T" + str.tostring(layer) + "|trend_state|active", "trend_state", layer, structureId, state, last.endTime, knownTime, sourceId, reason)

f_collect_divergence_snapshots(array<StructureSnapshot> snapshots, string marketTimeframe, array<Divergence> divergences, array<Unit> units, array<Center> centers, int layer) =>
    int count = array.size(divergences)
    if count > 0
        for i = 0 to count - 1
            Divergence current = array.get(divergences, i)
            string kind = current.kind == 2 ? "trend_divergence" : "consolidation_divergence"
            string structureId = f_divergence_structure_id(marketTimeframe, current)
            string state = not current.valid ? "invalidated" : current.confirmed ? "confirmed" : "candidate"
            int knownTime = state == "invalidated" ? current.evidenceEndTime : current.confirmed ? current.confirmationTime : current.firstKnownTime
            string unitKind = layer == 0 ? "segment" : "movement"
            int unitLayer = layer - 1
            string sourceCenterId = current.centerIndex >= 0 and current.centerIndex < array.size(centers) ? f_center_structure_id(marketTimeframe, array.get(centers, current.centerIndex), units, layer) : "na"
            string comparisonCenterId = current.comparisonCenter >= 0 and current.comparisonCenter < array.size(centers) ? f_center_structure_id(marketTimeframe, array.get(centers, current.comparisonCenter), units, layer) : "na"
            string sourceId = current.kind == 2 ? "a=" + f_indexed_unit_structure_id(marketTimeframe, units, current.firstEnteringUnit, unitKind, unitLayer) + "|A=" + comparisonCenterId + "|b=" + f_indexed_unit_structure_id(marketTimeframe, units, current.enteringUnit, unitKind, unitLayer) + "|B=" + sourceCenterId + "|c=" + f_indexed_unit_structure_id(marketTimeframe, units, current.leavingUnit, unitKind, unitLayer) + "|3p=" + f_indexed_unit_structure_id(marketTimeframe, units, current.thirdPointUnit, unitKind, unitLayer) : "enter=" + f_indexed_unit_structure_id(marketTimeframe, units, current.enteringUnit, unitKind, unitLayer) + "|center=" + sourceCenterId + "|leave=" + f_indexed_unit_structure_id(marketTimeframe, units, current.leavingUnit, unitKind, unitLayer)
            string reason = state == "invalidated" ? "confirmed_structure_crossed_invalidation" : current.confirmed ? "macd_area_weaker_on_confirmed_component" : "macd_area_weaker_on_candidate_component"
            f_add_structure_snapshot(snapshots, marketTimeframe, structureId, kind, layer, structureId, state, current.structureTime, knownTime, sourceId, reason)

f_collect_point_snapshots(array<StructureSnapshot> snapshots, string marketTimeframe, array<BuySellPoint> points, array<Unit> units, array<Divergence> divergences, array<Center> centers, array<BuySellPoint> lowerPoints, int layer) =>
    int count = array.size(points)
    if count > 0
        for i = 0 to count - 1
            BuySellPoint current = array.get(points, i)
            string kind = "point_" + str.tostring(current.pointClass)
            string structureId = f_point_structure_id(marketTimeframe, current)
            string state = not current.valid ? "invalidated" : current.confirmed ? "confirmed" : "candidate"
            int knownTime = state == "invalidated" ? current.evidenceEndTime : current.confirmed ? current.confirmationTime : current.firstKnownTime
            string unitKind = layer == 0 ? "segment" : "movement"
            int unitLayer = layer - 1
            string sourceId = "source=T" + str.tostring(current.sourceLayer) + "|structure=" + f_indexed_unit_structure_id(marketTimeframe, units, current.structureUnit, unitKind, unitLayer) + "|proof=" + f_indexed_unit_structure_id(marketTimeframe, units, current.proofUnit, unitKind, unitLayer)
            string causalSourceId = "na"
            if current.pointClass == 1 and not na(current.sourceDivergence) and current.sourceDivergence >= 0 and current.sourceDivergence < array.size(divergences)
                causalSourceId := f_divergence_structure_id(marketTimeframe, array.get(divergences, current.sourceDivergence))
                sourceId += "|divergence=" + causalSourceId
            else if current.pointClass == 2 and not na(current.linkedFirstPoint)
                if current.sourceLayer == layer and current.linkedFirstPoint >= 0 and current.linkedFirstPoint < array.size(points)
                    causalSourceId := f_point_structure_id(marketTimeframe, array.get(points, current.linkedFirstPoint))
                else if current.sourceLayer == layer - 1 and current.linkedFirstPoint >= 0 and current.linkedFirstPoint < array.size(lowerPoints)
                    causalSourceId := f_point_structure_id(marketTimeframe, array.get(lowerPoints, current.linkedFirstPoint))
                sourceId += "|first_point=" + causalSourceId
            else if current.pointClass == 3 and not na(current.sourceCenter) and current.sourceCenter >= 0 and current.sourceCenter < array.size(centers)
                causalSourceId := f_center_structure_id(marketTimeframe, array.get(centers, current.sourceCenter), units, layer)
                sourceId += "|center=" + causalSourceId
            string reason = state == "invalidated" ? (current.pointClass == 2 ? "completed_opposing_movement" : "confirmed_structure_crossed_invalidation") : current.confirmed ? "point_structure_completed" : "point_structure_candidate"
            f_add_structure_snapshot(snapshots, marketTimeframe, structureId, kind, layer, structureId, state, current.structureTime, knownTime, sourceId, reason)

f_collect_reference_snapshots(array<StructureSnapshot> snapshots, string marketTimeframe, ReferenceEngine engine) =>
    array<BuySellPoint> noLowerPoints = array.new<BuySellPoint>()
    f_collect_fractal_snapshots(snapshots, marketTimeframe, engine.endpoints)
    f_collect_stroke_snapshots(snapshots, marketTimeframe, engine.strokes, engine.endpoints)
    f_collect_unit_snapshots(snapshots, marketTimeframe, engine.segmentsS, "segment", -1, engine.strokes, "stroke", -2)
    f_collect_unit_snapshots(snapshots, marketTimeframe, engine.movementsT0, "movement", 0, engine.segmentsS, "segment", -1)
    f_collect_unit_snapshots(snapshots, marketTimeframe, engine.movementsT1, "movement", 1, engine.movementsT0, "movement", 0)
    f_collect_unit_snapshots(snapshots, marketTimeframe, engine.movementsT2, "movement", 2, engine.movementsT1, "movement", 1)
    f_collect_center_snapshots(snapshots, marketTimeframe, engine.centersT0, engine.segmentsS, 0)
    f_collect_center_snapshots(snapshots, marketTimeframe, engine.centersT1, engine.movementsT0, 1)
    f_collect_center_snapshots(snapshots, marketTimeframe, engine.centersT2, engine.movementsT1, 2)
    f_collect_trend_snapshot(snapshots, marketTimeframe, engine.trendT0, engine.centersT0, engine.segmentsS, 0)
    f_collect_trend_snapshot(snapshots, marketTimeframe, engine.trendT1, engine.centersT1, engine.movementsT0, 1)
    f_collect_trend_snapshot(snapshots, marketTimeframe, engine.trendT2, engine.centersT2, engine.movementsT1, 2)
    f_collect_divergence_snapshots(snapshots, marketTimeframe, engine.divergencesT0, engine.segmentsS, engine.centersT0, 0)
    f_collect_divergence_snapshots(snapshots, marketTimeframe, engine.divergencesT1, engine.movementsT0, engine.centersT1, 1)
    f_collect_divergence_snapshots(snapshots, marketTimeframe, engine.divergencesT2, engine.movementsT1, engine.centersT2, 2)
    f_collect_point_snapshots(snapshots, marketTimeframe, engine.pointsT0, engine.segmentsS, engine.divergencesT0, engine.centersT0, noLowerPoints, 0)
    f_collect_point_snapshots(snapshots, marketTimeframe, engine.pointsT1, engine.movementsT0, engine.divergencesT1, engine.centersT1, engine.pointsT0, 1)
    f_collect_point_snapshots(snapshots, marketTimeframe, engine.pointsT2, engine.movementsT1, engine.divergencesT2, engine.centersT2, engine.pointsT1, 2)

f_collect_focus_snapshots(array<StructureSnapshot> snapshots, string marketTimeframe, array<Fractal> endpoints, array<Unit> strokes, array<Unit> segments, array<Unit> movements0, array<Unit> movements1, array<Unit> movements2, array<Unit> movements3, array<Center> centers0, array<Center> centers1, array<Center> centers2, array<Center> centers3, array<Divergence> divergences0, array<Divergence> divergences1, array<Divergence> divergences2, array<Divergence> divergences3, array<BuySellPoint> points0, array<BuySellPoint> points1, array<BuySellPoint> points2, array<BuySellPoint> points3, array<BuySellPoint> noLowerPoints, TrendState trend0, TrendState trend1, TrendState trend2, TrendState trend3) =>
    f_collect_fractal_snapshots(snapshots, marketTimeframe, endpoints)
    f_collect_stroke_snapshots(snapshots, marketTimeframe, strokes, endpoints)
    f_collect_unit_snapshots(snapshots, marketTimeframe, segments, "segment", -1, strokes, "stroke", -2)
    f_collect_unit_snapshots(snapshots, marketTimeframe, movements0, "movement", 0, segments, "segment", -1)
    f_collect_unit_snapshots(snapshots, marketTimeframe, movements1, "movement", 1, movements0, "movement", 0)
    f_collect_unit_snapshots(snapshots, marketTimeframe, movements2, "movement", 2, movements1, "movement", 1)
    f_collect_unit_snapshots(snapshots, marketTimeframe, movements3, "movement", 3, movements2, "movement", 2)
    f_collect_center_snapshots(snapshots, marketTimeframe, centers0, segments, 0)
    f_collect_center_snapshots(snapshots, marketTimeframe, centers1, movements0, 1)
    f_collect_center_snapshots(snapshots, marketTimeframe, centers2, movements1, 2)
    f_collect_center_snapshots(snapshots, marketTimeframe, centers3, movements2, 3)
    f_collect_trend_snapshot(snapshots, marketTimeframe, trend0, centers0, segments, 0)
    f_collect_trend_snapshot(snapshots, marketTimeframe, trend1, centers1, movements0, 1)
    f_collect_trend_snapshot(snapshots, marketTimeframe, trend2, centers2, movements1, 2)
    f_collect_trend_snapshot(snapshots, marketTimeframe, trend3, centers3, movements2, 3)
    f_collect_divergence_snapshots(snapshots, marketTimeframe, divergences0, segments, centers0, 0)
    f_collect_divergence_snapshots(snapshots, marketTimeframe, divergences1, movements0, centers1, 1)
    f_collect_divergence_snapshots(snapshots, marketTimeframe, divergences2, movements1, centers2, 2)
    f_collect_divergence_snapshots(snapshots, marketTimeframe, divergences3, movements2, centers3, 3)
    f_collect_point_snapshots(snapshots, marketTimeframe, points0, segments, divergences0, centers0, noLowerPoints, 0)
    f_collect_point_snapshots(snapshots, marketTimeframe, points1, movements0, divergences1, centers1, points0, 1)
    f_collect_point_snapshots(snapshots, marketTimeframe, points2, movements1, divergences2, centers2, points1, 2)
    f_collect_point_snapshots(snapshots, marketTimeframe, points3, movements2, divergences3, centers3, points2, 3)

f_append_lifecycle_event(array<LifecycleEvent> events, StructureSnapshot snapshot, string state, string reason) =>
    int knownTime = state == "replaced" ? time : snapshot.knownTime
    int sequence = array.size(events)
    string eventId = snapshot.structureId + "|reason=" + reason + "|sequence=" + str.tostring(sequence)
    array.push(events, LifecycleEvent.new(snapshot.structureId, state, snapshot.structureTime, knownTime, snapshot.sourceId, reason, eventId))

f_reconcile_lifecycle(array<StructureSnapshot> previous, array<StructureSnapshot> current, array<LifecycleEvent> events) =>
    int currentCount = array.size(current)
    int previousCountBefore = array.size(previous)
    map<string, int> previousIndexBySlot = map.new<string, int>()
    map<string, int> currentIndexBySlot = map.new<string, int>()
    if previousCountBefore > 0
        for previousIndex = 0 to previousCountBefore - 1
            map.put(previousIndexBySlot, array.get(previous, previousIndex).slotId, previousIndex)
    if currentCount > 0
        for currentIndex = 0 to currentCount - 1
            map.put(currentIndexBySlot, array.get(current, currentIndex).slotId, currentIndex)
    bool initializing = previousCountBefore == 0 and array.size(events) == 0
    if initializing and currentCount > 0
        for currentIndex = 0 to currentCount - 1
            StructureSnapshot incoming = array.get(current, currentIndex)
            f_append_lifecycle_event(events, incoming, incoming.state, incoming.reason)

    int previousCount = array.size(previous)
    if previousCount > 0
        for previousIndex = 0 to previousCount - 1
            StructureSnapshot old = array.get(previous, previousIndex)
            int activeIndex = map.get(currentIndexBySlot, old.slotId)
            bool stillActive = not na(activeIndex)
            if not stillActive and old.state == "candidate"
                f_append_lifecycle_event(events, old, "replaced", "candidate_no_longer_active")

    if not initializing and currentCount > 0
        for currentIndex = 0 to currentCount - 1
            StructureSnapshot incoming = array.get(current, currentIndex)
            int previousIndex = map.get(previousIndexBySlot, incoming.slotId)
            if na(previousIndex)
                f_append_lifecycle_event(events, incoming, incoming.state, incoming.reason)
            else
                StructureSnapshot old = array.get(previous, previousIndex)
                if old.structureId != incoming.structureId
                    if old.state == "candidate"
                        f_append_lifecycle_event(events, old, "replaced", "more_extreme_or_new_terminal_candidate")
                    f_append_lifecycle_event(events, incoming, incoming.state, incoming.reason)
                else if old.state != incoming.state
                    f_append_lifecycle_event(events, incoming, incoming.state, incoming.reason)
                else if old.reason != incoming.reason
                    f_append_lifecycle_event(events, incoming, incoming.state, incoming.reason)

    array.clear(previous)
    if currentCount > 0
        for currentIndex = 0 to currentCount - 1
            array.push(previous, array.get(current, currentIndex))
    events

f_upsert_evidence(array<Evidence> ledger, Evidence incoming) =>
    // 证据身份必须包含结构时间：同层同方向可以同时存在多条来自不同
    // 结构事件的有效证据，缺少结构时间会让较早证据被较新证据顶替，
    // 永远进不了共振统计与提醒（事件 ID 本身就含结构时间，与其对齐）。
    int replaceIndex = na
    int evidenceCount = array.size(ledger)
    if evidenceCount > 0
        for evidenceIndex = 0 to evidenceCount - 1
            Evidence current = array.get(ledger, evidenceIndex)
            bool sameIdentity = current.market == incoming.market and current.layer == incoming.layer and current.kind == incoming.kind and current.direction == incoming.direction and current.confirmed == incoming.confirmed and current.structureTime == incoming.structureTime
            if sameIdentity
                replaceIndex := evidenceIndex
                break
    if na(replaceIndex)
        array.push(ledger, incoming)
    else
        Evidence current = array.get(ledger, replaceIndex)
        if incoming.evidenceStartTime >= current.evidenceStartTime
            array.set(ledger, replaceIndex, incoming)

f_collect_layer_evidence(array<Evidence> ledger, int marketId, string marketTimeframe, array<Unit> units, array<Divergence> divergences, array<BuySellPoint> points) =>
    int divergenceCount = array.size(divergences)
    if divergenceCount > 0
        for divergenceIndex = 0 to divergenceCount - 1
            Divergence current = array.get(divergences, divergenceIndex)
            bool active = current.confirmed ? current.valid : true
            if active
                int evidenceDirection = -current.direction
                int knownTime = current.confirmed ? current.confirmationTime : current.firstKnownTime
                float structureStartPrice = current.structurePrice
                if current.leavingUnit >= 0 and current.leavingUnit < array.size(units)
                    Unit leaving = array.get(units, current.leavingUnit)
                    structureStartPrice := leaving.startPrice
                string eventType = current.kind == 2 ? "trend_divergence" : "consolidation_divergence"
                string eventId = f_event_id(marketTimeframe, current.layer, eventType, evidenceDirection, current.structureTime)
                string movementContext = f_movement_context_id(marketTimeframe, current.layer, current.parentStartTime)
                Evidence evidence = Evidence.new(marketId, marketTimeframe, current.layer, current.kind, evidenceDirection, current.confirmed, current.invalidationCandidate, current.centerIndex, current.parentStartTime, current.structureTime, current.confirmationTime, knownTime, current.evidenceStartTime, current.evidenceEndTime, current.structurePrice, structureStartPrice, current.confirmationPrice, current.invalidationPrice, movementContext, eventId)
                f_upsert_evidence(ledger, evidence)

    int pointCount = array.size(points)
    if pointCount > 0
        for pointIndex = 0 to pointCount - 1
            BuySellPoint current = array.get(points, pointIndex)
            bool active = current.confirmed ? current.valid : true
            if active
                int intervalStartTime = current.structureTime
                float structureStartPrice = current.structurePrice
                if current.structureUnit >= 0 and current.structureUnit < array.size(units)
                    Unit sourceUnit = array.get(units, current.structureUnit)
                    intervalStartTime := sourceUnit.startTime
                    structureStartPrice := sourceUnit.startPrice
                int knownTime = current.confirmed ? current.confirmationTime : current.firstKnownTime
                string eventType = "point_" + str.tostring(current.pointClass)
                string eventId = f_event_id(marketTimeframe, current.layer, eventType, current.direction, current.structureTime)
                string movementContext = f_movement_context_id(marketTimeframe, current.layer, intervalStartTime)
                Evidence evidence = Evidence.new(marketId, marketTimeframe, current.layer, 10 + current.pointClass, current.direction, current.confirmed, current.invalidationCandidate, current.sourceCenter, intervalStartTime, current.structureTime, current.confirmationTime, knownTime, current.evidenceStartTime, current.evidenceEndTime, current.structurePrice, structureStartPrice, current.confirmationPrice, current.invalidationPrice, movementContext, eventId)
                f_upsert_evidence(ledger, evidence)

f_collect_nesting_evidence(array<Evidence> ledger, string marketTimeframe, array<Unit> units, array<Divergence> divergences) =>
    int divergenceCount = array.size(divergences)
    if divergenceCount > 0
        for divergenceIndex = 0 to divergenceCount - 1
            Divergence current = array.get(divergences, divergenceIndex)
            bool active = current.confirmed ? current.valid : true
            if active and current.leavingUnit >= 0 and current.leavingUnit < array.size(units)
                Unit leaving = array.get(units, current.leavingUnit)
                int evidenceDirection = -current.direction
                int knownTime = current.confirmed ? current.confirmationTime : current.firstKnownTime
                string eventType = current.kind == 2 ? "trend_divergence" : "consolidation_divergence"
                string eventId = f_event_id(marketTimeframe, current.layer, eventType, evidenceDirection, current.structureTime)
                string movementContext = f_movement_context_id(marketTimeframe, current.layer, current.parentStartTime)
                array.push(ledger, Evidence.new(0, marketTimeframe, current.layer, current.kind, evidenceDirection, current.confirmed, current.invalidationCandidate, current.centerIndex, current.parentStartTime, current.structureTime, current.confirmationTime, knownTime, current.evidenceStartTime, current.evidenceEndTime, current.structurePrice, leaving.startPrice, current.confirmationPrice, current.invalidationPrice, movementContext, eventId))

f_build_resonances(array<Evidence> ledger, array<Resonance> resonances) =>
    array.clear(resonances)
    int ledgerCount = array.size(ledger)
    if ledgerCount > 0
        for statusIndex = 0 to 1
            bool requiredConfirmed = statusIndex == 1
            for directionIndex = 0 to 1
                int requiredDirection = directionIndex == 0 ? -1 : 1
                for marketId = 0 to 4
                    int evidenceCount = 0
                    int identityCount = 0
                    int conflictCount = 0
                    int startTime = na
                    int knownTime = na
                    string componentIds = ""
                    string componentText = ""
                    bool seenL0 = false
                    bool seenL1 = false
                    bool seenL2 = false
                    bool seenL3 = false
                    for evidenceIndex = 0 to ledgerCount - 1
                        Evidence evidence = array.get(ledger, evidenceIndex)
                        bool sameStatusAndMarket = evidence.confirmed == requiredConfirmed and evidence.market == marketId
                        if sameStatusAndMarket and evidence.direction == requiredDirection
                            evidenceCount += 1
                            startTime := na(startTime) ? evidence.evidenceStartTime : math.max(startTime, evidence.evidenceStartTime)
                            knownTime := na(knownTime) ? evidence.knownTime : math.max(knownTime, evidence.knownTime)
                            componentIds += (componentIds == "" ? "" : ",") + evidence.eventId
                            componentText += (componentText == "" ? "" : "+") + f_evidence_short(evidence)
                            if evidence.layer == 0 and not seenL0
                                seenL0 := true
                                identityCount += 1
                            else if evidence.layer == 1 and not seenL1
                                seenL1 := true
                                identityCount += 1
                            else if evidence.layer == 2 and not seenL2
                                seenL2 := true
                                identityCount += 1
                            else if evidence.layer == 3 and not seenL3
                                seenL3 := true
                                identityCount += 1
                        else if sameStatusAndMarket and evidence.direction == -requiredDirection
                            conflictCount += 1
                    if identityCount >= 2
                        string eventId = f_event_prefix("resonance") + "|layer|" + str.tostring(marketId) + "|" + str.tostring(requiredDirection) + "|components=" + componentIds
                        array.push(resonances, Resonance.new(1, marketId, requiredDirection, requiredConfirmed, evidenceCount, identityCount, conflictCount, startTime, knownTime, componentIds, componentText, eventId))

                int crossEvidenceCount = 0
                int crossIdentityCount = 0
                int crossConflictCount = 0
                int crossStartTime = na
                int crossKnownTime = na
                string crossComponentIds = ""
                string crossComponentText = ""
                bool seenMarket0 = false
                bool seenMarket1 = false
                bool seenMarket2 = false
                bool seenMarket3 = false
                bool seenMarket4 = false
                for evidenceIndex = 0 to ledgerCount - 1
                    Evidence evidence = array.get(ledger, evidenceIndex)
                    if evidence.confirmed == requiredConfirmed and evidence.direction == requiredDirection
                        crossEvidenceCount += 1
                        crossStartTime := na(crossStartTime) ? evidence.evidenceStartTime : math.max(crossStartTime, evidence.evidenceStartTime)
                        crossKnownTime := na(crossKnownTime) ? evidence.knownTime : math.max(crossKnownTime, evidence.knownTime)
                        crossComponentIds += (crossComponentIds == "" ? "" : ",") + evidence.eventId
                        crossComponentText += (crossComponentText == "" ? "" : "+") + f_evidence_short(evidence)
                        if evidence.market == 0 and not seenMarket0
                            seenMarket0 := true
                            crossIdentityCount += 1
                        else if evidence.market == 1 and not seenMarket1
                            seenMarket1 := true
                            crossIdentityCount += 1
                        else if evidence.market == 2 and not seenMarket2
                            seenMarket2 := true
                            crossIdentityCount += 1
                        else if evidence.market == 3 and not seenMarket3
                            seenMarket3 := true
                            crossIdentityCount += 1
                        else if evidence.market == 4 and not seenMarket4
                            seenMarket4 := true
                            crossIdentityCount += 1
                    else if evidence.confirmed == requiredConfirmed and evidence.direction == -requiredDirection
                        crossConflictCount += 1
                if crossIdentityCount >= 2
                    string eventId = f_event_prefix("resonance") + "|timeframe|" + str.tostring(requiredDirection) + "|components=" + crossComponentIds
                    array.push(resonances, Resonance.new(2, -1, requiredDirection, requiredConfirmed, crossEvidenceCount, crossIdentityCount, crossConflictCount, crossStartTime, crossKnownTime, crossComponentIds, crossComponentText, eventId))

f_build_nesting(array<Evidence> ledger) =>
    NestingState result = NestingState.new(false, 0, false, true, 0, 0, na, na, na, na, "", "", "")
    int rootIndex = na
    int rootLayer = -1
    int latestRootTime = na
    int ledgerCount = array.size(ledger)
    if ledgerCount > 0
        for evidenceIndex = 0 to ledgerCount - 1
            Evidence evidence = array.get(ledger, evidenceIndex)
            bool divergenceEvidence = evidence.kind == 1 or evidence.kind == 2
            bool eligibleRoot = evidence.market == 0 and divergenceEvidence and evidence.layer >= 1 and not na(evidence.structureStartTime)
            if eligibleRoot and (evidence.layer > rootLayer or (evidence.layer == rootLayer and (na(latestRootTime) or evidence.structureTime > latestRootTime)))
                rootIndex := evidenceIndex
                rootLayer := evidence.layer
                latestRootTime := evidence.structureTime
    if not na(rootIndex)
        Evidence root = array.get(ledger, rootIndex)
        int depth = 1
        int parentStartTime = root.structureStartTime
        int parentEndTime = root.structureTime
        float parentStartPrice = root.structureStartPrice
        float parentEndPrice = root.structurePrice
        int chainKnownTime = root.knownTime
        bool chainConfirmed = root.confirmed
        string componentIds = root.eventId
        string componentText = f_evidence_short(root)
        if root.layer > 0
            for targetLayer = root.layer - 1 to 0
                int childIndex = na
                int childStructureTime = na
                for evidenceIndex = 0 to ledgerCount - 1
                    Evidence evidence = array.get(ledger, evidenceIndex)
                    bool divergenceEvidence = evidence.kind == 1 or evidence.kind == 2
                    bool sameChain = evidence.market == 0 and evidence.layer == targetLayer and divergenceEvidence and evidence.direction == root.direction
                    bool timeContained = evidence.structureStartTime >= parentStartTime and evidence.structureTime <= parentEndTime
                    float parentLow = math.min(parentStartPrice, parentEndPrice)
                    float parentHigh = math.max(parentStartPrice, parentEndPrice)
                    float childLow = math.min(evidence.structureStartPrice, evidence.structurePrice)
                    float childHigh = math.max(evidence.structureStartPrice, evidence.structurePrice)
                    bool priceContained = childLow >= parentLow and childHigh <= parentHigh
                    bool sameExtremeDirection = root.direction == 1 ? evidence.structureStartPrice >= evidence.structurePrice : evidence.structureStartPrice <= evidence.structurePrice
                    bool narrowsTowardExtreme = root.direction == 1 ? evidence.structurePrice >= parentEndPrice : evidence.structurePrice <= parentEndPrice
                    bool contained = sameChain and timeContained and priceContained and sameExtremeDirection and narrowsTowardExtreme
                    if contained and (na(childStructureTime) or evidence.structureTime > childStructureTime)
                        childIndex := evidenceIndex
                        childStructureTime := evidence.structureTime
                if na(childIndex)
                    break
                Evidence child = array.get(ledger, childIndex)
                depth += 1
                chainConfirmed := chainConfirmed and child.confirmed
                chainKnownTime := math.max(chainKnownTime, child.knownTime)
                componentIds += "," + child.eventId
                componentText += "→" + f_evidence_short(child)
                parentStartTime := child.structureStartTime
                parentEndTime := child.structureTime
                parentStartPrice := child.structureStartPrice
                parentEndPrice := child.structurePrice
        bool partial = depth < root.layer + 1
        string eventId = f_event_prefix(timeframe.period) + "|nesting|" + str.tostring(root.direction) + "|T" + str.tostring(root.layer) + "|" + str.tostring(root.structureTime) + "|components=" + componentIds
        result := NestingState.new(true, root.direction, chainConfirmed, partial, root.layer, depth, root.structureStartTime, parentEndTime, chainKnownTime, root.structurePrice, componentIds, componentText, eventId)
    result

f_previous_scenario_known(array<Scenario> previous, int layer, int kind, int direction, int sourceTime) =>
    int result = time
    int previousCount = array.size(previous)
    if previousCount > 0
        for previousIndex = 0 to previousCount - 1
            Scenario candidate = array.get(previous, previousIndex)
            bool sameIdentity = candidate.layer == layer and candidate.kind == kind and candidate.direction == direction and candidate.sourceTime == sourceTime
            if sameIdentity
                result := candidate.knownTime
                break
    result

f_add_scenario(array<Scenario> scenarios, array<Scenario> previous, int layer, int kind, int direction, int sourceIndex, int sourceTime, float anchorPrice, float triggerPrice, float invalidationPrice, string name, string triggerText, string invalidationText) =>
    bool duplicate = false
    int scenarioCount = array.size(scenarios)
    if scenarioCount > 0
        for scenarioIndex = 0 to scenarioCount - 1
            Scenario current = array.get(scenarios, scenarioIndex)
            if current.kind == kind and current.direction == direction and current.sourceTime == sourceTime
                duplicate := true
                break
    if not duplicate and scenarioCount < 5
        string eventId = f_event_prefix(timeframe.period) + "|T" + str.tostring(layer) + "|scenario|" + str.tostring(kind) + "|" + str.tostring(direction) + "|" + str.tostring(sourceTime)
        int knownTime = f_previous_scenario_known(previous, layer, kind, direction, sourceTime)
        array.push(scenarios, Scenario.new(layer, kind, direction, sourceIndex, sourceTime, knownTime, anchorPrice, triggerPrice, invalidationPrice, name, triggerText, invalidationText, eventId))

f_build_scenarios(array<Unit> units, array<Center> centers, TrendState trend, int layer, array<Scenario> scenarios) =>
    array<Scenario> previousScenarios = array.copy(scenarios)
    array.clear(scenarios)
    int centerCount = array.size(centers)
    int unitCount = array.size(units)
    if centerCount > 0 and unitCount > 0
        Center currentCenter = array.get(centers, centerCount - 1)
        Unit lastUnit = array.get(units, unitCount - 1)
        float anchorPrice = lastUnit.endPrice
        int structuralDirection = not na(trend) and trend.direction != 0 ? trend.direction : currentCenter.leaveDirection
        if currentCenter.leaveState == 0
            float extensionBoundary = lastUnit.direction == 1 ? currentCenter.zg : currentCenter.zd
            float extensionInvalidation = lastUnit.direction == 1 ? currentCenter.zd : currentCenter.zg
            f_add_scenario(scenarios, previousScenarios, layer, 1, 0, currentCenter.endIndex, currentCenter.endTime, anchorPrice, extensionBoundary, extensionInvalidation, "中枢延伸", "后续完整结构继续与固定 ZD/ZG 核心正宽度重叠", "结构完整离开核心后转入离开判定")
            f_add_scenario(scenarios, previousScenarios, layer, 2, 1, currentCenter.endIndex, currentCenter.endTime, anchorPrice, currentCenter.zg, currentCenter.zd, "向上离开", "完整结构位于 ZG 上方，等待首次反向回试", "回试重新进入核心则恢复中枢延伸")
            f_add_scenario(scenarios, previousScenarios, layer, 2, -1, currentCenter.endIndex, currentCenter.endTime, anchorPrice, currentCenter.zd, currentCenter.zg, "向下离开", "完整结构位于 ZD 下方，等待首次反向回试", "回试重新进入核心则恢复中枢延伸")
        else if currentCenter.leaveState == 1
            int leaveDirection = currentCenter.leaveDirection
            float returnBoundary = leaveDirection == 1 ? currentCenter.zg : currentCenter.zd
            float departureExtreme = leaveDirection == 1 ? currentCenter.gg : currentCenter.dd
            f_add_scenario(scenarios, previousScenarios, layer, 1, -leaveDirection, currentCenter.endIndex, currentCenter.endTime, anchorPrice, returnBoundary, departureExtreme, "离开回归", "反向回试重新进入固定核心", "回试保持核心外侧则离开获得确认")
            f_add_scenario(scenarios, previousScenarios, layer, 2, leaveDirection, currentCenter.endIndex, currentCenter.endTime, anchorPrice, returnBoundary, leaveDirection == 1 ? currentCenter.zd : currentCenter.zg, "离开确认", "首次完整回试保持在核心外侧", "回试重新进入核心则本分支撤销")
        else
            int leaveDirection = currentCenter.leaveDirection
            float newCenterAnchor = leaveDirection == 1 ? currentCenter.gg : currentCenter.dd
            float coreBoundary = leaveDirection == 1 ? currentCenter.zg : currentCenter.zd
            f_add_scenario(scenarios, previousScenarios, layer, 3, leaveDirection, currentCenter.endIndex, currentCenter.endTime, anchorPrice, newCenterAnchor, coreBoundary, "形成新中枢", "离开方向继续，并由三个连续下层结构建立新的同级中枢", "重新进入原核心则不构成外部新中枢")
            f_add_scenario(scenarios, previousScenarios, layer, 5, -leaveDirection, currentCenter.endIndex, currentCenter.endTime, anchorPrice, coreBoundary, leaveDirection == 1 ? currentCenter.gg : currentCenter.dd, "反向结构", "反向结构确认后冻结原走势边界", "原离开方向再次创新极值则完成候选失效")

        if currentCenter.expansionCandidate or currentCenter.failedDeparture
            f_add_scenario(scenarios, previousScenarios, layer, 4, 0, currentCenter.endIndex, currentCenter.endTime, anchorPrice, currentCenter.zg, currentCenter.zd, "扩展升级", "下层走势满足三段公共重叠后建立更高层中枢", "只有波动重叠而无高级结构时仍保持候选")
        if not na(trend) and trend.completionCandidate and structuralDirection != 0
            float reverseBoundary = structuralDirection == 1 ? currentCenter.zg : currentCenter.zd
            float trendExtreme = structuralDirection == 1 ? currentCenter.gg : currentCenter.dd
            f_add_scenario(scenarios, previousScenarios, layer, 5, -structuralDirection, currentCenter.endIndex, currentCenter.endTime, anchorPrice, reverseBoundary, trendExtreme, "完成候选确认", "反向结构、离开失败或层级升级确认原走势完成", "原方向结构创新极值则当前完成候选失效")

f_json_escape(string value) =>
    string escaped = str.replace_all(value, "\\", "\\\\")
    escaped := str.replace_all(escaped, "\"", "\\\"")
    escaped := str.replace_all(escaped, "\n", "\\n")
    escaped

f_json_int(int value) =>
    na(value) ? "null" : str.tostring(value)

f_json_float(float value) =>
    na(value) ? "null" : str.tostring(value, format.mintick)

f_json_payload(string eventId, string marketTimeframe, int layer, string movementContext, int direction, string eventType, string status, int structureTime, float structurePrice, int confirmationTime, float confirmationPrice, int sourceCenter, string evidenceSummary, string messageZh) =>
    string directionText = direction == 1 ? "buy" : direction == -1 ? "sell" : "neutral"
    "{\"event_id\":\"" + f_json_escape(eventId) + "\",\"symbol\":\"" + f_json_escape(syminfo.tickerid) + "\",\"market_timeframe\":\"" + f_json_escape(marketTimeframe) + "\",\"theory_version\":\"" + THEORY_VERSION + "\",\"stroke_definition\":\"course_new\",\"trend_level\":\"T" + str.tostring(layer) + "\",\"movement_context\":\"" + f_json_escape(movementContext) + "\",\"direction\":\"" + directionText + "\",\"type\":\"" + eventType + "\",\"status\":\"" + status + "\",\"structure_time\":" + f_json_int(structureTime) + ",\"structure_price\":" + f_json_float(structurePrice) + ",\"confirmation_time\":" + f_json_int(confirmationTime) + ",\"confirmation_price\":" + f_json_float(confirmationPrice) + ",\"source_center\":" + f_json_int(sourceCenter) + ",\"evidence\":\"" + f_json_escape(evidenceSummary) + "\",\"message_zh\":\"" + f_json_escape(messageZh) + "\"}"

f_event_was_emitted(array<string> emittedIds, string eventId) =>
    bool found = false
    int emittedCount = array.size(emittedIds)
    if emittedCount > 0
        for emittedIndex = 0 to emittedCount - 1
            if array.get(emittedIds, emittedIndex) == eventId
                found := true
                break
    found

f_remember_event(array<string> emittedIds, string eventKey) =>
    if not f_event_was_emitted(emittedIds, eventKey)
        array.push(emittedIds, eventKey)
        if array.size(emittedIds) > 500
            array.shift(emittedIds)

f_event_status_key(string eventId, bool confirmed) =>
    eventId + "|status=" + (confirmed ? "confirmed" : "candidate")

f_emit_once(array<string> emittedIds, string eventId, string payload) =>
    if not f_event_was_emitted(emittedIds, eventId)
        alert(payload, alert.freq_all)
        array.push(emittedIds, eventId)
        if array.size(emittedIds) > 500
            array.shift(emittedIds)

f_evidence_payload(Evidence evidence) =>
    string eventType = evidence.kind == 1 ? "consolidation_divergence" : evidence.kind == 2 ? "trend_divergence" : evidence.kind == 11 ? "point_1" : evidence.kind == 12 ? "point_2" : "point_3"
    string status = evidence.confirmed ? "confirmed" : "candidate"
    string invalidationState = evidence.invalidationCandidate ? "invalidation_candidate" : "active"
    string evidenceSummary = f_evidence_short(evidence) + ";invalidation=" + str.tostring(evidence.invalidationPrice, format.mintick) + ";context=" + invalidationState
    string messageZh = f_evidence_short(evidence) + (evidence.confirmed ? " 已确认" : " 候选") + (evidence.invalidationCandidate ? "，当前价格越界但等待结构确认失效" : "")
    f_json_payload(evidence.eventId, evidence.marketTimeframe, evidence.layer, evidence.movementContext, evidence.direction, eventType, status, evidence.structureTime, evidence.structurePrice, evidence.confirmationTime, evidence.confirmationPrice, evidence.sourceIndex, evidenceSummary, messageZh)

f_process_reference_bar(bool enabled, int sourceTime, float sourceHigh, float sourceLow, float sourceDif, float sourceHist, int knownTime, ReferenceState state, array<KBar> bars, array<Fractal> endpoints, array<Unit> strokes, array<float> pendingHighs, array<float> pendingLows, array<int> pendingIndices, array<int> pendingTimes, array<float> posAreaCums, array<float> negAreaCums, array<float> difValues, bool allowConfirmation) =>
    bool newConfirmedBar = enabled and not na(sourceTime) and (na(state.lastSourceTime) or sourceTime != state.lastSourceTime)
    if newConfirmedBar
        int sourceIndex = state.nextIndex
        state.lastSourceTime := sourceTime
        state.nextIndex += 1
        state.lastKnownTime := knownTime
        f_push_macd_cums(posAreaCums, negAreaCums, sourceHist)
        array.push(difValues, sourceDif)
        bool appendedSynthetic = false
        if not state.seedReady
            array.push(pendingHighs, sourceHigh)
            array.push(pendingLows, sourceLow)
            array.push(pendingIndices, sourceIndex)
            array.push(pendingTimes, sourceTime)
            state.seedDirection := f_seed_direction(pendingHighs, pendingLows)
            if state.seedDirection != 0
                state.seedReady := true
                int pendingCount = array.size(pendingHighs)
                for i = 0 to pendingCount - 1
                    bool replayAppended = f_ingest_kbar(bars, array.get(pendingHighs, i), array.get(pendingLows, i), array.get(pendingIndices, i), array.get(pendingTimes, i), state.seedDirection)
                    appendedSynthetic := appendedSynthetic or replayAppended
                array.clear(pendingHighs)
                array.clear(pendingLows)
                array.clear(pendingIndices)
                array.clear(pendingTimes)
        else
            appendedSynthetic := f_ingest_kbar(bars, sourceHigh, sourceLow, sourceIndex, sourceTime, state.seedDirection)

        if appendedSynthetic
            Fractal confirmedFractal = f_detect_confirmed_fractal(bars, knownTime)
            if not na(confirmedFractal)
                bool structuresChanged = f_update_strokes(endpoints, strokes, confirmedFractal, posAreaCums, negAreaCums, difValues, allowConfirmation)
                state.structuresDirty := state.structuresDirty or structuresChanged
        if not allowConfirmation
            f_extend_terminal_candidate(strokes, sourceIndex, sourceTime, sourceHigh, sourceLow, posAreaCums, negAreaCums, difValues)
    state

f_ingest_reference(bool enabled, int sourceTime, float sourceHigh, float sourceLow, float sourceDif, float sourceHist, int knownTime, ReferenceEngine engine, bool allowConfirmation) =>
    engine.state := f_process_reference_bar(enabled, sourceTime, sourceHigh, sourceLow, sourceDif, sourceHist, knownTime, engine.state, engine.bars, engine.endpoints, engine.strokes, engine.pendingHighs, engine.pendingLows, engine.pendingIndices, engine.pendingTimes, engine.posAreaCums, engine.negAreaCums, engine.difValues, allowConfirmation)
    engine

f_build_reference_engine(ReferenceEngine engine) =>
    array<BuySellPoint> noLowerPoints = array.new<BuySellPoint>()
    f_build_recursive_layer(engine.strokes, engine.segmentsS, -1, engine.posAreaCums, engine.negAreaCums, engine.difValues)
    f_build_centers(engine.segmentsS, engine.centersT0, 0)
    f_build_divergences(engine.segmentsS, engine.centersT0, engine.divergencesT0, 0, MACD_WARMUP_BARS)
    f_build_completed_movements(engine.segmentsS, engine.centersT0, engine.divergencesT0, engine.movementsT0, 0, engine.posAreaCums, engine.negAreaCums, engine.difValues)

    f_build_centers(engine.movementsT0, engine.centersT1, 1)
    f_build_divergences(engine.movementsT0, engine.centersT1, engine.divergencesT1, 1, MACD_WARMUP_BARS)
    f_build_completed_movements(engine.movementsT0, engine.centersT1, engine.divergencesT1, engine.movementsT1, 1, engine.posAreaCums, engine.negAreaCums, engine.difValues)

    f_build_centers(engine.movementsT1, engine.centersT2, 2)
    f_build_divergences(engine.movementsT1, engine.centersT2, engine.divergencesT2, 2, MACD_WARMUP_BARS)
    f_build_completed_movements(engine.movementsT1, engine.centersT2, engine.divergencesT2, engine.movementsT2, 2, engine.posAreaCums, engine.negAreaCums, engine.difValues)
    f_link_center_promotions(engine.centersT0, engine.centersT1, engine.movementsT0)
    f_link_center_promotions(engine.centersT1, engine.centersT2, engine.movementsT1)
    f_build_points(engine.segmentsS, engine.centersT0, engine.divergencesT0, engine.movementsT0, noLowerPoints, engine.pointsT0, 0)
    f_build_points(engine.movementsT0, engine.centersT1, engine.divergencesT1, engine.movementsT1, engine.pointsT0, engine.pointsT1, 1)
    f_build_points(engine.movementsT1, engine.centersT2, engine.divergencesT2, engine.movementsT2, engine.pointsT1, engine.pointsT2, 2)
    engine.trendT0 := f_get_trend_state(engine.centersT0, engine.divergencesT0, engine.movementsT0, 0)
    engine.trendT1 := f_get_trend_state(engine.centersT1, engine.divergencesT1, engine.movementsT1, 1)
    engine.trendT2 := f_get_trend_state(engine.centersT2, engine.divergencesT2, engine.movementsT2, 2)
    engine.state.structuresDirty := false
    engine

f_build_focus_hierarchy(array<Unit> sourceStrokes, array<float> posAreaCums, array<float> negAreaCums, array<float> difValues, array<Unit> segments, array<Unit> movements0, array<Unit> movements1, array<Unit> movements2, array<Unit> movements3, array<Center> centers0, array<Center> centers1, array<Center> centers2, array<Center> centers3, array<Divergence> divergences0, array<Divergence> divergences1, array<Divergence> divergences2, array<Divergence> divergences3, array<BuySellPoint> points0, array<BuySellPoint> points1, array<BuySellPoint> points2, array<BuySellPoint> points3) =>
    array<BuySellPoint> noLowerPoints = array.new<BuySellPoint>()
    f_build_recursive_layer(sourceStrokes, segments, -1, posAreaCums, negAreaCums, difValues)
    f_build_centers(segments, centers0, 0)
    f_build_divergences(segments, centers0, divergences0, 0, MACD_WARMUP_BARS)
    f_build_completed_movements(segments, centers0, divergences0, movements0, 0, posAreaCums, negAreaCums, difValues)

    f_build_centers(movements0, centers1, 1)
    f_build_divergences(movements0, centers1, divergences1, 1, MACD_WARMUP_BARS)
    f_build_completed_movements(movements0, centers1, divergences1, movements1, 1, posAreaCums, negAreaCums, difValues)

    f_build_centers(movements1, centers2, 2)
    f_build_divergences(movements1, centers2, divergences2, 2, MACD_WARMUP_BARS)
    f_build_completed_movements(movements1, centers2, divergences2, movements2, 2, posAreaCums, negAreaCums, difValues)

    f_build_centers(movements2, centers3, 3)
    f_build_divergences(movements2, centers3, divergences3, 3, MACD_WARMUP_BARS)
    f_build_completed_movements(movements2, centers3, divergences3, movements3, 3, posAreaCums, negAreaCums, difValues)

    f_link_center_promotions(centers0, centers1, movements0)
    f_link_center_promotions(centers1, centers2, movements1)
    f_link_center_promotions(centers2, centers3, movements2)
    f_build_points(segments, centers0, divergences0, movements0, noLowerPoints, points0, 0)
    f_build_points(movements0, centers1, divergences1, movements1, points0, points1, 1)
    f_build_points(movements1, centers2, divergences2, movements2, points1, points2, 2)
    f_build_points(movements2, centers3, divergences3, movements3, points2, points3, 3)
    TrendState state0 = f_get_trend_state(centers0, divergences0, movements0, 0)
    TrendState state1 = f_get_trend_state(centers1, divergences1, movements1, 1)
    TrendState state2 = f_get_trend_state(centers2, divergences2, movements2, 2)
    TrendState state3 = f_get_trend_state(centers3, divergences3, movements3, 3)
    [state0, state1, state2, state3]

// -----------------------------------------------------------------------------
// Focus-timeframe incremental engine
// -----------------------------------------------------------------------------

bool standardChart = chart.is_standard
string referenceTimeframe1 = useAutoReferences ? f_auto_reference_timeframe(1) : manualReference1
string referenceTimeframe2 = useAutoReferences ? f_auto_reference_timeframe(2) : manualReference2
string referenceTimeframe3 = useAutoReferences ? f_auto_reference_timeframe(3) : manualReference3
string referenceTimeframe4 = useAutoReferences ? f_auto_reference_timeframe(4) : manualReference4
int focusTimeframeSeconds = int(timeframe.in_seconds())
int referenceSeconds1 = referenceTimeframe1 == "" ? 0 : int(timeframe.in_seconds(referenceTimeframe1))
int referenceSeconds2 = referenceTimeframe2 == "" ? 0 : int(timeframe.in_seconds(referenceTimeframe2))
int referenceSeconds3 = referenceTimeframe3 == "" ? 0 : int(timeframe.in_seconds(referenceTimeframe3))
int referenceSeconds4 = referenceTimeframe4 == "" ? 0 : int(timeframe.in_seconds(referenceTimeframe4))
bool referenceRequested1 = referenceCount >= 1
bool referenceRequested2 = referenceCount >= 2
bool referenceRequested3 = referenceCount >= 3
bool referenceRequested4 = referenceCount >= 4
bool referenceConfigured1 = referenceRequested1 and referenceSeconds1 > focusTimeframeSeconds
bool referenceConfigured2 = referenceRequested2 and referenceSeconds2 > focusTimeframeSeconds and referenceTimeframe2 != referenceTimeframe1
bool referenceConfigured3 = referenceRequested3 and referenceSeconds3 > focusTimeframeSeconds and referenceTimeframe3 != referenceTimeframe1 and referenceTimeframe3 != referenceTimeframe2
bool referenceConfigured4 = referenceRequested4 and referenceSeconds4 > focusTimeframeSeconds and referenceTimeframe4 != referenceTimeframe1 and referenceTimeframe4 != referenceTimeframe2 and referenceTimeframe4 != referenceTimeframe3
bool referenceEnabled1 = standardChart and referenceConfigured1
bool referenceEnabled2 = standardChart and referenceConfigured2
bool referenceEnabled3 = standardChart and referenceConfigured3
bool referenceEnabled4 = standardChart and referenceConfigured4
bool manualReferenceConfigurationValid = (not referenceRequested1 or referenceConfigured1) and (not referenceRequested2 or referenceConfigured2) and (not referenceRequested3 or referenceConfigured3) and (not referenceRequested4 or referenceConfigured4)
if barstate.isfirst and not useAutoReferences and not manualReferenceConfigurationValid
    runtime.error("手动参考周期必须唯一且严格高于当前图表周期")
int activeReferenceCount = (referenceEnabled1 ? 1 : 0) + (referenceEnabled2 ? 1 : 0) + (referenceEnabled3 ? 1 : 0) + (referenceEnabled4 ? 1 : 0)
int referenceSourceTime1 = na
float referenceSourceHigh1 = na
float referenceSourceLow1 = na
float referenceSourceDif1 = na
float referenceSourceHist1 = na
if referenceEnabled1
    [requestedTime1, requestedHigh1, requestedLow1, requestedDif1, requestedHist1] = request.security(syminfo.tickerid, referenceTimeframe1, f_reference_source(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
    referenceSourceTime1 := requestedTime1
    referenceSourceHigh1 := requestedHigh1
    referenceSourceLow1 := requestedLow1
    referenceSourceDif1 := requestedDif1
    referenceSourceHist1 := requestedHist1

int referenceSourceTime2 = na
float referenceSourceHigh2 = na
float referenceSourceLow2 = na
float referenceSourceDif2 = na
float referenceSourceHist2 = na
if referenceEnabled2
    [requestedTime2, requestedHigh2, requestedLow2, requestedDif2, requestedHist2] = request.security(syminfo.tickerid, referenceTimeframe2, f_reference_source(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
    referenceSourceTime2 := requestedTime2
    referenceSourceHigh2 := requestedHigh2
    referenceSourceLow2 := requestedLow2
    referenceSourceDif2 := requestedDif2
    referenceSourceHist2 := requestedHist2

int referenceSourceTime3 = na
float referenceSourceHigh3 = na
float referenceSourceLow3 = na
float referenceSourceDif3 = na
float referenceSourceHist3 = na
if referenceEnabled3
    [requestedTime3, requestedHigh3, requestedLow3, requestedDif3, requestedHist3] = request.security(syminfo.tickerid, referenceTimeframe3, f_reference_source(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
    referenceSourceTime3 := requestedTime3
    referenceSourceHigh3 := requestedHigh3
    referenceSourceLow3 := requestedLow3
    referenceSourceDif3 := requestedDif3
    referenceSourceHist3 := requestedHist3

int referenceSourceTime4 = na
float referenceSourceHigh4 = na
float referenceSourceLow4 = na
float referenceSourceDif4 = na
float referenceSourceHist4 = na
if referenceEnabled4
    [requestedTime4, requestedHigh4, requestedLow4, requestedDif4, requestedHist4] = request.security(syminfo.tickerid, referenceTimeframe4, f_reference_source(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
    referenceSourceTime4 := requestedTime4
    referenceSourceHigh4 := requestedHigh4
    referenceSourceLow4 := requestedLow4
    referenceSourceDif4 := requestedDif4
    referenceSourceHist4 := requestedHist4

var ReferenceEngine referenceEngine1 = f_new_reference_engine()
var ReferenceEngine referenceEngine2 = f_new_reference_engine()
var ReferenceEngine referenceEngine3 = f_new_reference_engine()
var ReferenceEngine referenceEngine4 = f_new_reference_engine()
referenceEngine1 := f_ingest_reference(referenceEnabled1, referenceSourceTime1, referenceSourceHigh1, referenceSourceLow1, referenceSourceDif1, referenceSourceHist1, time, referenceEngine1, true)
referenceEngine2 := f_ingest_reference(referenceEnabled2, referenceSourceTime2, referenceSourceHigh2, referenceSourceLow2, referenceSourceDif2, referenceSourceHist2, time, referenceEngine2, true)
referenceEngine3 := f_ingest_reference(referenceEnabled3, referenceSourceTime3, referenceSourceHigh3, referenceSourceLow3, referenceSourceDif3, referenceSourceHist3, time, referenceEngine3, true)
referenceEngine4 := f_ingest_reference(referenceEnabled4, referenceSourceTime4, referenceSourceHigh4, referenceSourceLow4, referenceSourceDif4, referenceSourceHist4, time, referenceEngine4, true)
bool referenceStructuresDirty1 = referenceEngine1.state.structuresDirty
bool referenceStructuresDirty2 = referenceEngine2.state.structuresDirty
bool referenceStructuresDirty3 = referenceEngine3.state.structuresDirty
bool referenceStructuresDirty4 = referenceEngine4.state.structuresDirty
if referenceStructuresDirty1
    referenceEngine1 := f_build_reference_engine(referenceEngine1)
if referenceStructuresDirty2
    referenceEngine2 := f_build_reference_engine(referenceEngine2)
if referenceStructuresDirty3
    referenceEngine3 := f_build_reference_engine(referenceEngine3)
if referenceStructuresDirty4
    referenceEngine4 := f_build_reference_engine(referenceEngine4)

var array<KBar> syntheticBars = array.new<KBar>()
var array<Fractal> baseFractals = array.new<Fractal>()
var array<Fractal> strokeEndpoints = array.new<Fractal>()
var array<Unit> strokes = array.new<Unit>()
var array<KBar> viewSyntheticBars = array.new<KBar>()
var array<Fractal> viewStrokeEndpoints = array.new<Fractal>()
var array<Unit> viewStrokes = array.new<Unit>()
var array<float> viewPosAreaCums = array.new<float>()
var array<float> viewNegAreaCums = array.new<float>()
var array<float> viewDifValues = array.new<float>()
var array<Unit> segmentsS = array.new<Unit>()
var array<Unit> movementsT0 = array.new<Unit>()
var array<Unit> movementsT1 = array.new<Unit>()
var array<Unit> movementsT2 = array.new<Unit>()
var array<Unit> movementsT3 = array.new<Unit>()
var array<Center> centersT0 = array.new<Center>()
var array<Center> centersT1 = array.new<Center>()
var array<Center> centersT2 = array.new<Center>()
var array<Center> centersT3 = array.new<Center>()
var array<Divergence> divergencesT0 = array.new<Divergence>()
var array<Divergence> divergencesT1 = array.new<Divergence>()
var array<Divergence> divergencesT2 = array.new<Divergence>()
var array<Divergence> divergencesT3 = array.new<Divergence>()
var array<BuySellPoint> pointsT0 = array.new<BuySellPoint>()
var array<BuySellPoint> pointsT1 = array.new<BuySellPoint>()
var array<BuySellPoint> pointsT2 = array.new<BuySellPoint>()
var array<BuySellPoint> pointsT3 = array.new<BuySellPoint>()
var array<BuySellPoint> noLowerPointSources = array.new<BuySellPoint>()
varip array<StructureSnapshot> previousFocusStructureSnapshots = array.new<StructureSnapshot>()
varip array<StructureSnapshot> previousReferenceStructureSnapshots1 = array.new<StructureSnapshot>()
varip array<StructureSnapshot> previousReferenceStructureSnapshots2 = array.new<StructureSnapshot>()
varip array<StructureSnapshot> previousReferenceStructureSnapshots3 = array.new<StructureSnapshot>()
varip array<StructureSnapshot> previousReferenceStructureSnapshots4 = array.new<StructureSnapshot>()
var array<StructureSnapshot> currentStructureSnapshots = array.new<StructureSnapshot>()
var array<LifecycleEvent> lifecycleEvents = array.new<LifecycleEvent>()
var array<Evidence> activeEvidence = array.new<Evidence>()
var array<Evidence> nestingEvidence = array.new<Evidence>()
var array<Resonance> activeResonances = array.new<Resonance>()
var NestingState nestingState = na
var array<Scenario> activeScenarios = array.new<Scenario>()
varip array<string> emittedEventIds = array.new<string>()
varip bool alertBaselineReady = false
var TrendState trendT0 = na
var TrendState trendT1 = na
var TrendState trendT2 = na
var TrendState trendT3 = na
var array<float> pendingHighs = array.new<float>()
var array<float> pendingLows = array.new<float>()
var array<int> pendingIndices = array.new<int>()
var array<int> pendingTimes = array.new<int>()
var array<float> posAreaCums = array.new<float>()
var array<float> negAreaCums = array.new<float>()
var array<float> difValues = array.new<float>()
var bool seedReady = false
var int seedDirection = 0
var int lastProcessedRawIndex = na
var int dataStartTime = na
var int reliableStartTime = na
var bool focusStructuresDirty = false

float normalizedHigh = math.round_to_mintick(high)
float normalizedLow = math.round_to_mintick(low)
float normalizedClose = math.round_to_mintick(close)
[difValue, signalValue, macdHistValue] = ta.macd(normalizedClose, 12, 26, 9)

bool confirmedRawBar = barstate.isconfirmed and standardChart
if barstate.isfirst
    dataStartTime := time
if confirmedRawBar and (na(lastProcessedRawIndex) or bar_index != lastProcessedRawIndex)
    lastProcessedRawIndex := bar_index
    array.push(difValues, difValue)
    f_push_macd_cums(posAreaCums, negAreaCums, macdHistValue)
    bool appendedSynthetic = false
    if not seedReady
        array.push(pendingHighs, normalizedHigh)
        array.push(pendingLows, normalizedLow)
        array.push(pendingIndices, bar_index)
        array.push(pendingTimes, time)
        seedDirection := f_seed_direction(pendingHighs, pendingLows)
        if seedDirection != 0
            seedReady := true
            int pendingCount = array.size(pendingHighs)
            for i = 0 to pendingCount - 1
                bool replayAppended = f_ingest_kbar(syntheticBars, array.get(pendingHighs, i), array.get(pendingLows, i), array.get(pendingIndices, i), array.get(pendingTimes, i), seedDirection)
                appendedSynthetic := appendedSynthetic or replayAppended
            array.clear(pendingHighs)
            array.clear(pendingLows)
            array.clear(pendingIndices)
            array.clear(pendingTimes)
    else
        appendedSynthetic := f_ingest_kbar(syntheticBars, normalizedHigh, normalizedLow, bar_index, time, seedDirection)

    if appendedSynthetic
        Fractal confirmedFractal = f_detect_confirmed_fractal(syntheticBars, time)
        if not na(confirmedFractal)
            array.push(baseFractals, confirmedFractal)
            bool structuresChanged = f_update_strokes(strokeEndpoints, strokes, confirmedFractal, posAreaCums, negAreaCums, difValues, true)
            focusStructuresDirty := focusStructuresDirty or structuresChanged

bool focusReplayDirty = confirmedRawBar and focusStructuresDirty
if focusReplayDirty
    [historyTrendT0, historyTrendT1, historyTrendT2, historyTrendT3] = f_build_focus_hierarchy(strokes, posAreaCums, negAreaCums, difValues, segmentsS, movementsT0, movementsT1, movementsT2, movementsT3, centersT0, centersT1, centersT2, centersT3, divergencesT0, divergencesT1, divergencesT2, divergencesT3, pointsT0, pointsT1, pointsT2, pointsT3)
    trendT0 := historyTrendT0
    trendT1 := historyTrendT1
    trendT2 := historyTrendT2
    trendT3 := historyTrendT3
    focusStructuresDirty := false

if focusReplayDirty
    array.clear(currentStructureSnapshots)
    f_collect_focus_snapshots(currentStructureSnapshots, timeframe.period, strokeEndpoints, strokes, segmentsS, movementsT0, movementsT1, movementsT2, movementsT3, centersT0, centersT1, centersT2, centersT3, divergencesT0, divergencesT1, divergencesT2, divergencesT3, pointsT0, pointsT1, pointsT2, pointsT3, noLowerPointSources, trendT0, trendT1, trendT2, trendT3)
    lifecycleEvents := f_reconcile_lifecycle(previousFocusStructureSnapshots, currentStructureSnapshots, lifecycleEvents)
if referenceStructuresDirty1
    array.clear(currentStructureSnapshots)
    f_collect_reference_snapshots(currentStructureSnapshots, referenceTimeframe1, referenceEngine1)
    lifecycleEvents := f_reconcile_lifecycle(previousReferenceStructureSnapshots1, currentStructureSnapshots, lifecycleEvents)
if referenceStructuresDirty2
    array.clear(currentStructureSnapshots)
    f_collect_reference_snapshots(currentStructureSnapshots, referenceTimeframe2, referenceEngine2)
    lifecycleEvents := f_reconcile_lifecycle(previousReferenceStructureSnapshots2, currentStructureSnapshots, lifecycleEvents)
if referenceStructuresDirty3
    array.clear(currentStructureSnapshots)
    f_collect_reference_snapshots(currentStructureSnapshots, referenceTimeframe3, referenceEngine3)
    lifecycleEvents := f_reconcile_lifecycle(previousReferenceStructureSnapshots3, currentStructureSnapshots, lifecycleEvents)
if referenceStructuresDirty4
    array.clear(currentStructureSnapshots)
    f_collect_reference_snapshots(currentStructureSnapshots, referenceTimeframe4, referenceEngine4)
    lifecycleEvents := f_reconcile_lifecycle(previousReferenceStructureSnapshots4, currentStructureSnapshots, lifecycleEvents)

if barstate.islast
    viewSyntheticBars := f_tail_isolated_kbars(syntheticBars)
    viewStrokeEndpoints := array.copy(strokeEndpoints)
    viewStrokes := f_tail_isolated_units(strokes)
    viewPosAreaCums := array.copy(posAreaCums)
    viewNegAreaCums := array.copy(negAreaCums)
    viewDifValues := array.copy(difValues)
    if standardChart and not barstate.isconfirmed
        array.push(viewDifValues, difValue)
        f_push_macd_cums(viewPosAreaCums, viewNegAreaCums, macdHistValue)
        bool previewAppendedSynthetic = false
        if seedReady
            previewAppendedSynthetic := f_ingest_kbar(viewSyntheticBars, normalizedHigh, normalizedLow, bar_index, time, seedDirection)
        else
            array<float> previewPendingHighs = array.copy(pendingHighs)
            array<float> previewPendingLows = array.copy(pendingLows)
            array<int> previewPendingIndices = array.copy(pendingIndices)
            array<int> previewPendingTimes = array.copy(pendingTimes)
            array.push(previewPendingHighs, normalizedHigh)
            array.push(previewPendingLows, normalizedLow)
            array.push(previewPendingIndices, bar_index)
            array.push(previewPendingTimes, time)
            int previewSeedDirection = f_seed_direction(previewPendingHighs, previewPendingLows)
            if previewSeedDirection != 0
                int previewPendingCount = array.size(previewPendingHighs)
                for i = 0 to previewPendingCount - 1
                    bool replayAppended = f_ingest_kbar(viewSyntheticBars, array.get(previewPendingHighs, i), array.get(previewPendingLows, i), array.get(previewPendingIndices, i), array.get(previewPendingTimes, i), previewSeedDirection)
                    previewAppendedSynthetic := previewAppendedSynthetic or replayAppended
        if previewAppendedSynthetic
            Fractal previewFractal = f_detect_confirmed_fractal(viewSyntheticBars, na)
            if not na(previewFractal)
                f_update_strokes(viewStrokeEndpoints, viewStrokes, previewFractal, viewPosAreaCums, viewNegAreaCums, viewDifValues, false)
        f_extend_terminal_candidate(viewStrokes, bar_index, time, normalizedHigh, normalizedLow, viewPosAreaCums, viewNegAreaCums, viewDifValues)

    [currentTrendT0, currentTrendT1, currentTrendT2, currentTrendT3] = f_build_focus_hierarchy(viewStrokes, viewPosAreaCums, viewNegAreaCums, viewDifValues, segmentsS, movementsT0, movementsT1, movementsT2, movementsT3, centersT0, centersT1, centersT2, centersT3, divergencesT0, divergencesT1, divergencesT2, divergencesT3, pointsT0, pointsT1, pointsT2, pointsT3)
    trendT0 := currentTrendT0
    trendT1 := currentTrendT1
    trendT2 := currentTrendT2
    trendT3 := currentTrendT3
    if na(reliableStartTime) and bar_index >= MACD_WARMUP_BARS and f_has_reliable_confirmed_center(segmentsS, MACD_WARMUP_BARS)
        reliableStartTime := time
    array.clear(currentStructureSnapshots)
    f_collect_focus_snapshots(currentStructureSnapshots, timeframe.period, viewStrokeEndpoints, viewStrokes, segmentsS, movementsT0, movementsT1, movementsT2, movementsT3, centersT0, centersT1, centersT2, centersT3, divergencesT0, divergencesT1, divergencesT2, divergencesT3, pointsT0, pointsT1, pointsT2, pointsT3, noLowerPointSources, trendT0, trendT1, trendT2, trendT3)
    if referenceEnabled1
        f_collect_reference_snapshots(currentStructureSnapshots, referenceTimeframe1, referenceEngine1)
    if referenceEnabled2
        f_collect_reference_snapshots(currentStructureSnapshots, referenceTimeframe2, referenceEngine2)
    if referenceEnabled3
        f_collect_reference_snapshots(currentStructureSnapshots, referenceTimeframe3, referenceEngine3)
    if referenceEnabled4
        f_collect_reference_snapshots(currentStructureSnapshots, referenceTimeframe4, referenceEngine4)
    array.clear(activeEvidence)
    f_collect_layer_evidence(activeEvidence, 0, timeframe.period, segmentsS, divergencesT0, pointsT0)
    f_collect_layer_evidence(activeEvidence, 0, timeframe.period, movementsT0, divergencesT1, pointsT1)
    f_collect_layer_evidence(activeEvidence, 0, timeframe.period, movementsT1, divergencesT2, pointsT2)
    f_collect_layer_evidence(activeEvidence, 0, timeframe.period, movementsT2, divergencesT3, pointsT3)
    if referenceEnabled1
        f_collect_layer_evidence(activeEvidence, 1, referenceTimeframe1, referenceEngine1.segmentsS, referenceEngine1.divergencesT0, referenceEngine1.pointsT0)
        f_collect_layer_evidence(activeEvidence, 1, referenceTimeframe1, referenceEngine1.movementsT0, referenceEngine1.divergencesT1, referenceEngine1.pointsT1)
        f_collect_layer_evidence(activeEvidence, 1, referenceTimeframe1, referenceEngine1.movementsT1, referenceEngine1.divergencesT2, referenceEngine1.pointsT2)
    if referenceEnabled2
        f_collect_layer_evidence(activeEvidence, 2, referenceTimeframe2, referenceEngine2.segmentsS, referenceEngine2.divergencesT0, referenceEngine2.pointsT0)
        f_collect_layer_evidence(activeEvidence, 2, referenceTimeframe2, referenceEngine2.movementsT0, referenceEngine2.divergencesT1, referenceEngine2.pointsT1)
        f_collect_layer_evidence(activeEvidence, 2, referenceTimeframe2, referenceEngine2.movementsT1, referenceEngine2.divergencesT2, referenceEngine2.pointsT2)
    if referenceEnabled3
        f_collect_layer_evidence(activeEvidence, 3, referenceTimeframe3, referenceEngine3.segmentsS, referenceEngine3.divergencesT0, referenceEngine3.pointsT0)
        f_collect_layer_evidence(activeEvidence, 3, referenceTimeframe3, referenceEngine3.movementsT0, referenceEngine3.divergencesT1, referenceEngine3.pointsT1)
        f_collect_layer_evidence(activeEvidence, 3, referenceTimeframe3, referenceEngine3.movementsT1, referenceEngine3.divergencesT2, referenceEngine3.pointsT2)
    if referenceEnabled4
        f_collect_layer_evidence(activeEvidence, 4, referenceTimeframe4, referenceEngine4.segmentsS, referenceEngine4.divergencesT0, referenceEngine4.pointsT0)
        f_collect_layer_evidence(activeEvidence, 4, referenceTimeframe4, referenceEngine4.movementsT0, referenceEngine4.divergencesT1, referenceEngine4.pointsT1)
        f_collect_layer_evidence(activeEvidence, 4, referenceTimeframe4, referenceEngine4.movementsT1, referenceEngine4.divergencesT2, referenceEngine4.pointsT2)
    f_build_resonances(activeEvidence, activeResonances)
    array.clear(nestingEvidence)
    f_collect_nesting_evidence(nestingEvidence, timeframe.period, segmentsS, divergencesT0)
    f_collect_nesting_evidence(nestingEvidence, timeframe.period, movementsT0, divergencesT1)
    f_collect_nesting_evidence(nestingEvidence, timeframe.period, movementsT1, divergencesT2)
    f_collect_nesting_evidence(nestingEvidence, timeframe.period, movementsT2, divergencesT3)
    nestingState := f_build_nesting(nestingEvidence)
    if array.size(centersT3) > 0
        f_build_scenarios(movementsT2, centersT3, trendT3, 3, activeScenarios)
    else if array.size(centersT2) > 0
        f_build_scenarios(movementsT1, centersT2, trendT2, 2, activeScenarios)
    else if array.size(centersT1) > 0
        f_build_scenarios(movementsT0, centersT1, trendT1, 1, activeScenarios)
    else
        f_build_scenarios(segmentsS, centersT0, trendT0, 0, activeScenarios)

if barstate.islast and barstate.isrealtime and standardChart
    int evidenceCountForAlerts = array.size(activeEvidence)
    int resonanceCountForAlerts = array.size(activeResonances)
    int scenarioCountForAlerts = array.size(activeScenarios)
    if not alertBaselineReady
        if evidenceCountForAlerts > 0
            for evidenceIndex = 0 to evidenceCountForAlerts - 1
                Evidence evidence = array.get(activeEvidence, evidenceIndex)
                f_remember_event(emittedEventIds, f_event_status_key(evidence.eventId, evidence.confirmed))
        if resonanceCountForAlerts > 0
            for resonanceIndex = 0 to resonanceCountForAlerts - 1
                Resonance resonance = array.get(activeResonances, resonanceIndex)
                f_remember_event(emittedEventIds, f_event_status_key(resonance.eventId, resonance.confirmed))
        if not na(nestingState) and nestingState.active
            f_remember_event(emittedEventIds, f_event_status_key(nestingState.eventId, nestingState.confirmed))
        if scenarioCountForAlerts > 0
            for scenarioIndex = 0 to scenarioCountForAlerts - 1
                Scenario scenario = array.get(activeScenarios, scenarioIndex)
                f_remember_event(emittedEventIds, f_event_status_key(scenario.eventId, false))
        alertBaselineReady := true
    else
        if evidenceCountForAlerts > 0
            for evidenceIndex = 0 to evidenceCountForAlerts - 1
                Evidence evidence = array.get(activeEvidence, evidenceIndex)
                bool categoryEnabled = evidence.kind <= 2 ? alertDivergence : alertBuySell
                bool statusEnabled = evidence.confirmed or alertCandidates
                bool newlyKnown = not na(evidence.knownTime) and evidence.knownTime >= time
                if categoryEnabled and statusEnabled and newlyKnown
                    f_emit_once(emittedEventIds, f_event_status_key(evidence.eventId, evidence.confirmed), f_evidence_payload(evidence))

        if alertResonance and resonanceCountForAlerts > 0
            for resonanceIndex = 0 to resonanceCountForAlerts - 1
                Resonance resonance = array.get(activeResonances, resonanceIndex)
                bool statusEnabled = resonance.confirmed or alertCandidates
                bool newlyKnown = not na(resonance.knownTime) and resonance.knownTime >= time
                if statusEnabled and newlyKnown
                    string resonanceTimeframe = resonance.scope == 2 ? "multi" : resonance.market == 0 ? timeframe.period : resonance.market == 1 ? referenceTimeframe1 : resonance.market == 2 ? referenceTimeframe2 : resonance.market == 3 ? referenceTimeframe3 : referenceTimeframe4
                    string resonanceType = resonance.scope == 1 ? "layer_resonance" : "timeframe_resonance"
                    string resonanceStatus = resonance.confirmed ? "confirmed" : "candidate"
                    string resonanceEvidence = resonance.componentText + ";conflicts=" + str.tostring(resonance.conflictCount)
                    string resonanceMessage = (resonance.scope == 1 ? "层间" : "跨周期") + (resonance.direction == 1 ? "买向" : "卖向") + "共振，组成证据 " + str.tostring(resonance.evidenceCount) + " 项，冲突 " + str.tostring(resonance.conflictCount) + " 项"
                    string payload = f_json_payload(resonance.eventId, resonanceTimeframe, -1, "composite_movement_contexts", resonance.direction, resonanceType, resonanceStatus, resonance.startTime, na, resonance.confirmed ? resonance.knownTime : na, na, na, resonanceEvidence, resonanceMessage)
                    f_emit_once(emittedEventIds, f_event_status_key(resonance.eventId, resonance.confirmed), payload)

        if alertNesting and not na(nestingState) and nestingState.active
            bool statusEnabled = nestingState.confirmed or alertCandidates
            bool newlyKnown = not na(nestingState.knownTime) and nestingState.knownTime >= time
            if statusEnabled and newlyKnown
                string nestingStatus = nestingState.confirmed ? "confirmed" : "candidate"
                string nestingEvidence = nestingState.componentText + ";partial=" + str.tostring(nestingState.partial) + ";depth=" + str.tostring(nestingState.depth)
                string nestingMessage = (nestingState.partial ? "部分" : "完整") + (nestingState.direction == 1 ? "买向" : "卖向") + "区间套，深度 " + str.tostring(nestingState.depth)
                string payload = f_json_payload(nestingState.eventId, timeframe.period, nestingState.rootLayer, "nested_movement_contexts", nestingState.direction, "nesting", nestingStatus, nestingState.endTime, nestingState.price, nestingState.confirmed ? nestingState.knownTime : na, na, na, nestingEvidence, nestingMessage)
                f_emit_once(emittedEventIds, f_event_status_key(nestingState.eventId, nestingState.confirmed), payload)

        if alertScenario and alertCandidates and scenarioCountForAlerts > 0
            for scenarioIndex = 0 to scenarioCountForAlerts - 1
                Scenario scenario = array.get(activeScenarios, scenarioIndex)
                if scenario.knownTime >= time
                    string scenarioEvidence = "trigger=" + scenario.triggerText + ";invalidation=" + scenario.invalidationText + ";layout_only=true"
                    string scenarioMessage = "走势终完美候选分支：" + scenario.name + "。不表示目标价、时间或概率"
                    string movementContext = f_movement_context_id(timeframe.period, scenario.layer, scenario.sourceTime)
                    string payload = f_json_payload(scenario.eventId, timeframe.period, scenario.layer, movementContext, scenario.direction, "scenario", "candidate", scenario.sourceTime, scenario.anchorPrice, na, na, na, scenarioEvidence, scenarioMessage)
                    f_emit_once(emittedEventIds, f_event_status_key(scenario.eventId, false), payload)

// -----------------------------------------------------------------------------
// Presentation foundation
// -----------------------------------------------------------------------------

int warmupBars = MACD_WARMUP_BARS
bool warmedUp = bar_index >= warmupBars

color backgroundColor = colorTheme == "色觉友好" ? color.rgb(20, 24, 28) : colorTheme == "中国市场" ? color.rgb(28, 24, 24) : chart.bg_color
color foregroundColor = colorTheme == "色觉友好" ? color.rgb(236, 239, 241) : chart.fg_color
color warningColor = color.rgb(245, 166, 35)

color upColor = colorTheme == "中国市场" ? color.rgb(220, 62, 62) : colorTheme == "色觉友好" ? color.rgb(0, 158, 115) : color.rgb(38, 166, 154)
color downColor = colorTheme == "中国市场" ? color.rgb(38, 166, 154) : colorTheme == "色觉友好" ? color.rgb(213, 94, 0) : color.rgb(239, 83, 80)
color candidateColor = color.rgb(245, 166, 35)
color layer1Color = color.rgb(33, 150, 243)
color layer2Color = color.rgb(255, 193, 7)
color layer3Color = color.rgb(156, 39, 176)

f_center_summary(array<Center> centers) =>
    string result = "0"
    int count = array.size(centers)
    if count > 0
        Center latest = array.get(centers, count - 1)
        string state = not latest.confirmed ? "核心候选" : latest.leaveState == 2 ? "离开确认" : latest.leaveState == 1 ? "离开候选" : latest.failedDeparture ? "延伸·离开失败" : "延伸"
        string lifecycle = latest.confirmed and not latest.stateConfirmed ? "·状态候选" : ""
        string expansion = latest.expansionConfirmed ? "·已升级T" + str.tostring(latest.layer + 1) : latest.expansionCandidate ? "·扩展候选" : ""
        result := str.tostring(count) + "·" + state + lifecycle + expansion
    result

f_trend_summary(TrendState state) =>
    string result = "未形成"
    if not na(state) and state.kind > 0
        string kind = state.kind == 2 ? "趋势" : "盘整"
        string direction = state.direction == 1 ? "上" : state.direction == -1 ? "下" : "待定"
        string status = state.status == MOVEMENT_COMPLETED ? "已完成" : state.status == MOVEMENT_COMPLETION_CANDIDATE ? "完成候选" : state.status == MOVEMENT_QUALIFIED ? "已具备" : "形成中"
        string proof = state.status == MOVEMENT_COMPLETED and state.completionProof == MOVEMENT_COMPLETED_BY_PROMOTION ? "·升级确认" : state.status == MOVEMENT_COMPLETED ? "·反向确认" : ""
        result := kind + direction + "·" + str.tostring(state.centerCount) + "枢·" + status + proof
    result

f_divergence_summary(array<Divergence> divergences) =>
    string result = "无"
    int count = array.size(divergences)
    if count > 0
        Divergence latest = array.get(divergences, count - 1)
        string kind = latest.kind == 2 ? "趋势背驰" : "盘整背驰"
        string direction = latest.direction == 1 ? "顶" : "底"
        string status = latest.confirmed ? "确认" : "候选"
        result := str.tostring(count) + "·" + kind + direction + "·" + status + "·" + str.tostring(latest.areaRatio, "#.###")
    result

f_point_summary(array<BuySellPoint> points) =>
    int class1Count = 0
    int class2Count = 0
    int class3Count = 0
    int candidateCount = 0
    int activeCount = 0
    int pointCount = array.size(points)
    if pointCount > 0
        for i = 0 to pointCount - 1
            BuySellPoint current = array.get(points, i)
            class1Count += current.pointClass == 1 and current.confirmed ? 1 : 0
            class2Count += current.pointClass == 2 and current.confirmed ? 1 : 0
            class3Count += current.pointClass == 3 and current.confirmed ? 1 : 0
            candidateCount += current.confirmed ? 0 : 1
            activeCount += current.confirmed and current.valid ? 1 : 0
    "1/2/3=" + str.tostring(class1Count) + "/" + str.tostring(class2Count) + "/" + str.tostring(class3Count) + "·活" + str.tostring(activeCount) + "·候" + str.tostring(candidateCount)

f_point_triplet(array<BuySellPoint> points) =>
    int class1Count = 0
    int class2Count = 0
    int class3Count = 0
    int pointCount = array.size(points)
    if pointCount > 0
        for i = 0 to pointCount - 1
            BuySellPoint current = array.get(points, i)
            class1Count += current.pointClass == 1 and current.confirmed ? 1 : 0
            class2Count += current.pointClass == 2 and current.confirmed ? 1 : 0
            class3Count += current.pointClass == 3 and current.confirmed ? 1 : 0
    str.tostring(class1Count) + "/" + str.tostring(class2Count) + "/" + str.tostring(class3Count)

f_reference_summary(bool requested, bool enabled, string referenceTimeframe, ReferenceEngine engine) =>
    string result = requested ? (standardChart ? "不可用/截断" : "合成图表暂停") : "关闭"
    if enabled
        string unitCounts = str.tostring(array.size(engine.strokes)) + "/" + str.tostring(array.size(engine.segmentsS)) + "/" + str.tostring(array.size(engine.movementsT0))
        string pointCounts = f_point_triplet(engine.pointsT0) + "|" + f_point_triplet(engine.pointsT1) + "|" + f_point_triplet(engine.pointsT2)
        result := referenceTimeframe + "·确K" + str.tostring(engine.state.nextIndex) + "·B/S/T0=" + unitCounts + "·P=" + pointCounts
    result

f_evidence_summary(array<Evidence> ledger) =>
    int confirmedCount = 0
    int candidateCount = 0
    int invalidationCandidateCount = 0
    int evidenceCount = array.size(ledger)
    if evidenceCount > 0
        for evidenceIndex = 0 to evidenceCount - 1
            Evidence evidence = array.get(ledger, evidenceIndex)
            confirmedCount += evidence.confirmed ? 1 : 0
            candidateCount += evidence.confirmed ? 0 : 1
            invalidationCandidateCount += evidence.invalidationCandidate ? 1 : 0
    "确" + str.tostring(confirmedCount) + "·候" + str.tostring(candidateCount) + "·失候" + str.tostring(invalidationCandidateCount)

f_resonance_summary(array<Resonance> resonances, int scope) =>
    string result = "无"
    int latestIndex = na
    int latestStart = na
    int resonanceCount = array.size(resonances)
    if resonanceCount > 0
        for resonanceIndex = 0 to resonanceCount - 1
            Resonance resonance = array.get(resonances, resonanceIndex)
            if resonance.scope == scope and (na(latestStart) or resonance.startTime > latestStart or (resonance.startTime == latestStart and resonance.confirmed))
                latestIndex := resonanceIndex
                latestStart := resonance.startTime
    if not na(latestIndex)
        Resonance latest = array.get(resonances, latestIndex)
        string sideText = latest.direction == 1 ? "买" : "卖"
        string statusText = latest.confirmed ? "确" : "候"
        result := sideText + statusText + "·" + str.tostring(latest.identityCount) + "身份/" + str.tostring(latest.evidenceCount) + "证·冲" + str.tostring(latest.conflictCount)
    result

f_resonance_tooltip(array<Resonance> resonances, int scope) =>
    string result = "当前没有活动共振"
    int latestIndex = na
    int latestStart = na
    int resonanceCount = array.size(resonances)
    if resonanceCount > 0
        for resonanceIndex = 0 to resonanceCount - 1
            Resonance resonance = array.get(resonances, resonanceIndex)
            if resonance.scope == scope and (na(latestStart) or resonance.startTime > latestStart or (resonance.startTime == latestStart and resonance.confirmed))
                latestIndex := resonanceIndex
                latestStart := resonance.startTime
    if not na(latestIndex)
        Resonance latest = array.get(resonances, latestIndex)
        result := "组成证据: " + latest.componentText + "\n反向冲突证据: " + str.tostring(latest.conflictCount) + "\n共振不是第四类买卖点"
    result

f_nesting_summary(NestingState nesting) =>
    string result = "无"
    if not na(nesting) and nesting.active
        string sideText = nesting.direction == 1 ? "买" : "卖"
        string statusText = nesting.confirmed ? "确" : "候"
        string partialText = nesting.partial ? "部分" : "完整"
        result := partialText + "·" + sideText + statusText + "·T" + str.tostring(nesting.rootLayer) + "×" + str.tostring(nesting.depth)
    result

f_nesting_tooltip(NestingState nesting) =>
    not na(nesting) and nesting.active ? "父子包含链: " + nesting.componentText + "\n低层链节只收窄范围，不独自确认高层完成" : "当前没有活动区间套"

f_scenario_summary(array<Scenario> scenarios) =>
    string result = "无完整走势状态"
    int scenarioCount = array.size(scenarios)
    if scenarioCount > 0
        result := str.tostring(scenarioCount) + "支"
        for scenarioIndex = 0 to scenarioCount - 1
            Scenario scenario = array.get(scenarios, scenarioIndex)
            result += (scenarioIndex == 0 ? "·" : "/") + scenario.name
    result

f_scenario_tooltip(array<Scenario> scenarios) =>
    string result = "走势终完美只约束合法结构分支，不预测目标价、时间或概率"
    int scenarioCount = array.size(scenarios)
    if scenarioCount > 0
        result := "横向长度仅用于排版，不预测完成时间"
        for scenarioIndex = 0 to scenarioCount - 1
            Scenario scenario = array.get(scenarios, scenarioIndex)
            result += "\n" + str.tostring(scenarioIndex + 1) + ". " + scenario.name + "｜触发: " + scenario.triggerText + "｜失效: " + scenario.invalidationText
    result

f_trade_signal_summary(array<Evidence> ledger) =>
    string result = "无活动信号"
    int resultDirection = 0
    bool resultConfirmed = false
    int latestKnownTime = na
    int latestPriority = 0
    int evidenceCount = array.size(ledger)
    if evidenceCount > 0
        for evidenceIndex = 0 to evidenceCount - 1
            Evidence evidence = array.get(ledger, evidenceIndex)
            int priority = evidence.kind >= 11 ? 2 : 1
            bool later = not na(evidence.knownTime) and (na(latestKnownTime) or evidence.knownTime > latestKnownTime or (evidence.knownTime == latestKnownTime and priority > latestPriority))
            if later
                string kindText = evidence.kind == 1 ? "盘背" : evidence.kind == 2 ? "趋背" : evidence.kind == 11 ? "1类" : evidence.kind == 12 ? "2类" : "3类"
                result := kindText + (evidence.direction == 1 ? "买" : "卖") + "·" + evidence.marketTimeframe + "·T" + str.tostring(evidence.layer) + "·" + (evidence.confirmed ? "确认" : "候选")
                resultDirection := evidence.direction
                resultConfirmed := evidence.confirmed
                latestKnownTime := evidence.knownTime
                latestPriority := priority
    [result, resultDirection, resultConfirmed]

f_draw_centers(array<Center> centers, array<box> boxes, array<label> labels, color layerColor, int maxDraw, int detailBars, bool showWave) =>
    int centerCount = array.size(centers)
    if centerCount > 0 and maxDraw > 0
        int firstCenter = math.max(0, centerCount - maxDraw)
        for i = firstCenter to centerCount - 1
            Center current = array.get(centers, i)
            bool visualConfirmed = current.confirmed and current.stateConfirmed
            if (visualConfirmed or showCandidates) and current.endIndex >= bar_index - detailBars and array.size(boxes) < 480
                int drawLeft = math.max(current.startIndex, bar_index - detailBars)
                color centerColor = visualConfirmed ? layerColor : candidateColor
                string centerStyle = visualConfirmed ? line.style_solid : line.style_dashed
                box coreBox = box.new(left = drawLeft, top = current.zg, right = current.endIndex, bottom = current.zd, xloc = xloc.bar_index, border_color = centerColor, border_width = visualConfirmed ? 2 : 1, border_style = centerStyle, bgcolor = color.new(centerColor, visualConfirmed ? 88 : 93))
                array.push(boxes, coreBox)
                if showWave and array.size(boxes) < 480
                    box waveBox = box.new(left = drawLeft, top = current.gg, right = current.endIndex, bottom = current.dd, xloc = xloc.bar_index, border_color = color.new(centerColor, 45), border_width = 1, border_style = line.style_dotted, bgcolor = color.new(centerColor, 100))
                    array.push(boxes, waveBox)
                string stateText = current.expansionConfirmed ? "升确" : current.leaveState == 2 ? "离确" : current.leaveState == 1 ? "离候" : current.failedDeparture ? "离败" : visualConfirmed ? "延" : "延候"
                string centerText = "Z·T" + str.tostring(current.layer) + "·" + stateText
                string promotionText = current.expansionConfirmed ? "\n高级中枢: T" + str.tostring(current.layer + 1) + " #" + str.tostring(current.parentCenter) + "\n三走势来源: " + str.tostring(current.promotionSourceFirst) + "/" + str.tostring(current.promotionSourceSecond) + "/" + str.tostring(current.promotionSourceThird) : current.expansionCandidate ? "\n高级中枢: 仅扩展候选，等待三走势确认来源" : ""
                string centerTooltip = "中枢核心 ZD/ZG: " + str.tostring(current.zd, format.mintick) + " / " + str.tostring(current.zg, format.mintick) + "\n波动 DD/GG: " + str.tostring(current.dd, format.mintick) + " / " + str.tostring(current.gg, format.mintick) + "\n来源单元: " + str.tostring(current.startChild) + ".." + str.tostring(current.endChild) + promotionText
                if array.size(labels) < 480
                    label centerLabel = label.new(current.endIndex, current.zg, centerText, xloc = xloc.bar_index, style = label.style_label_left, color = color.new(centerColor, 74), textcolor = foregroundColor, size = size.tiny, tooltip = centerTooltip)
                    array.push(labels, centerLabel)

f_draw_divergences(array<Divergence> divergences, array<label> labels, color layerColor, int maxDraw, int detailBars, bool activeOnly, bool compactTrading) =>
    int divergenceCount = array.size(divergences)
    int drawnCount = 0
    if divergenceCount > 0 and maxDraw > 0
        for offset = 0 to divergenceCount - 1
            if drawnCount >= maxDraw or array.size(labels) >= 480
                break
            int i = divergenceCount - 1 - offset
            Divergence current = array.get(divergences, i)
            bool activeVisible = not activeOnly or not current.confirmed or current.valid
            if activeVisible and current.structureIndex >= bar_index - detailBars and (current.confirmed or showCandidates) and array.size(labels) < 480
                color divergenceColor = current.confirmed ? layerColor : candidateColor
                string kindText = current.kind == 2 ? "趋背" : "盘背"
                string stateText = current.confirmed ? "确" : "候"
                string divergenceText = compactTrading ? kindText + (current.direction == 1 ? "卖" : "买") + "·T" + str.tostring(current.layer) : kindText + "·T" + str.tostring(current.layer) + "·" + stateText
                string difText = current.difWeaker ? "减弱" : "未减弱"
                string divergenceTooltip = "MACD 同向面积: " + str.tostring(current.enteringArea, "#.####") + " -> " + str.tostring(current.leavingArea, "#.####") + "\n面积比: " + str.tostring(current.areaRatio, "#.###") + "\nDIF 极值: " + difText + "\n结构时间: " + str.format_time(current.structureTime, "yyyy-MM-dd HH:mm") + (current.confirmed ? "\n确认时间: " + str.format_time(current.confirmationTime, "yyyy-MM-dd HH:mm") : "")
                string divergenceStyle = current.direction == 1 ? label.style_label_down : label.style_label_up
                label divergenceLabel = label.new(current.structureIndex, current.structurePrice, divergenceText, xloc = xloc.bar_index, style = divergenceStyle, color = color.new(divergenceColor, current.confirmed ? 18 : 55), textcolor = foregroundColor, size = compactTrading ? size.small : size.tiny, tooltip = divergenceTooltip)
                array.push(labels, divergenceLabel)
                drawnCount += 1

f_draw_points(array<BuySellPoint> points, array<line> lines, array<label> labels, int maxDraw, int detailBars, bool activeOnly, bool drawPointLabels, bool drawEvidenceRanges, bool compactTrading) =>
    int pointCount = array.size(points)
    int drawnCount = 0
    if pointCount > 0 and maxDraw > 0 and (drawPointLabels or drawEvidenceRanges)
        for offset = 0 to pointCount - 1
            if drawnCount >= maxDraw or ((not drawPointLabels or array.size(labels) >= 480) and (not drawEvidenceRanges or array.size(lines) >= 470))
                break
            int i = pointCount - 1 - offset
            BuySellPoint current = array.get(points, i)
            bool activeVisible = not activeOnly or not current.confirmed or current.valid
            bool labelVisible = drawPointLabels and (current.confirmed or showCandidates) and array.size(labels) < 480
            bool rangeVisible = drawEvidenceRanges and current.confirmed and current.structureIndex >= bar_index - detailBars and array.size(lines) < 470
            if activeVisible and (labelVisible or rangeVisible)
                color identityColor = current.direction == 1 ? upColor : downColor
                if labelVisible
                    color pointColor = not current.confirmed ? candidateColor : current.valid ? identityColor : color.gray
                    string sideText = current.direction == 1 ? "B" : "S"
                    string pointText = compactTrading ? str.tostring(current.pointClass) + (current.direction == 1 ? "买" : "卖") + "·T" + str.tostring(current.layer) : str.tostring(current.pointClass) + sideText + "·T" + str.tostring(current.layer)
                    string pointStatus = not current.confirmed ? "候选" : current.valid ? (current.invalidationCandidate ? "失效候选" : "有效") : "已失效"
                    string delayText = na(current.confirmationDelayBars) ? "待确认" : str.tostring(current.confirmationDelayBars) + " K"
                    string pointTooltip = "身份: " + str.tostring(current.pointClass) + " 类" + (current.direction == 1 ? "买点" : "卖点") + "\n状态: " + pointStatus + "\n结构价: " + str.tostring(current.structurePrice, format.mintick) + "\n结构时间: " + str.format_time(current.structureTime, "yyyy-MM-dd HH:mm") + (current.confirmed ? "\n确认价: " + str.tostring(current.confirmationPrice, format.mintick) + "\n确认时间: " + str.format_time(current.confirmationTime, "yyyy-MM-dd HH:mm") + "\n确认延迟: " + delayText : "") + "\n失效边界: " + str.tostring(current.invalidationPrice, format.mintick)
                    string pointStyle = current.direction == 1 ? label.style_label_up : label.style_label_down
                    label pointLabel = label.new(current.structureTime, current.structurePrice, pointText, xloc = xloc.bar_time, style = pointStyle, color = color.new(pointColor, current.confirmed ? 8 : 48), textcolor = foregroundColor, size = compactTrading ? size.small : size.tiny, tooltip = pointTooltip)
                    array.push(labels, pointLabel)
                if rangeVisible
                    int evidenceEndTime = current.valid ? time : current.evidenceEndTime
                    color evidenceColor = current.invalidationCandidate ? candidateColor : current.valid ? identityColor : color.gray
                    line evidenceLine = line.new(current.evidenceStartTime, current.invalidationPrice, evidenceEndTime, current.invalidationPrice, xloc = xloc.bar_time, color = color.new(evidenceColor, 45), style = line.style_dotted, width = 1)
                    array.push(lines, evidenceLine)
                drawnCount += 1
    drawnCount

f_draw_scenarios(array<Scenario> scenarios, array<line> lines, array<label> labels) =>
    int scenarioCount = array.size(scenarios)
    if showScenarios and viewPreset != "交易" and scenarioCount > 0
        for scenarioIndex = 0 to scenarioCount - 1
            Scenario scenario = array.get(scenarios, scenarioIndex)
            color scenarioColor = scenario.direction == 1 ? upColor : scenario.direction == -1 ? downColor : candidateColor
            int bendIndex = bar_index + 2 + scenarioIndex * 2
            int endIndex = bendIndex + 6
            bool lineBudgetAvailable = array.size(lines) <= 488
            line routeLine = lineBudgetAvailable ? line.new(bar_index, scenario.anchorPrice, bendIndex, scenario.triggerPrice, xloc = xloc.bar_index, color = color.new(scenarioColor, 28), style = line.style_dashed, width = 1) : na
            line conditionLine = lineBudgetAvailable ? line.new(bendIndex, scenario.triggerPrice, endIndex, scenario.triggerPrice, xloc = xloc.bar_index, color = color.new(scenarioColor, 45), style = line.style_dotted, width = 1) : na
            string scenarioText = "P" + str.tostring(scenarioIndex + 1) + "·" + scenario.name + "·T" + str.tostring(scenario.layer)
            string scenarioTooltip = "候选情景，不是预测\n触发: " + scenario.triggerText + "\n失效: " + scenario.invalidationText + "\n锚点: " + str.tostring(scenario.triggerPrice, format.mintick) + "\n横向长度仅用于排版，不表示时间或概率"
            label scenarioLabel = array.size(labels) < 480 ? label.new(endIndex, scenario.triggerPrice, scenarioText, xloc = xloc.bar_index, style = label.style_label_left, color = color.new(scenarioColor, 48), textcolor = foregroundColor, size = size.tiny, tooltip = scenarioTooltip) : na
            if not na(routeLine)
                array.push(lines, routeLine)
                array.push(lines, conditionLine)
            if not na(scenarioLabel)
                array.push(labels, scenarioLabel)

var array<line> structureLines = array.new<line>()
var array<label> structureLabels = array.new<label>()
var array<box> structureBoxes = array.new<box>()
bool tradingView = viewPreset == "交易"
int pointRenderBudget = tradingView ? 220 : viewPreset == "简洁" ? 120 : viewPreset == "标准" ? 300 : 260
int totalPointHistory = array.size(pointsT0) + array.size(pointsT1) + array.size(pointsT2) + array.size(pointsT3)
bool pointHistoryClipped = (showBuySellPoints or showEvidenceRanges) and totalPointHistory > pointRenderBudget

if barstate.islast
    int oldLineCount = array.size(structureLines)
    if oldLineCount > 0
        for i = 0 to oldLineCount - 1
            line.delete(array.get(structureLines, i))
        array.clear(structureLines)
    int oldLabelCount = array.size(structureLabels)
    if oldLabelCount > 0
        for i = 0 to oldLabelCount - 1
            label.delete(array.get(structureLabels, i))
        array.clear(structureLabels)
    int oldBoxCount = array.size(structureBoxes)
    if oldBoxCount > 0
        for i = 0 to oldBoxCount - 1
            box.delete(array.get(structureBoxes, i))
        array.clear(structureBoxes)

    int strokeCountForDraw = array.size(viewStrokes)
    if showStrokes and (viewPreset == "标准" or viewPreset == "研究") and strokeCountForDraw > 0
        int strokeDrawBudget = viewPreset == "标准" ? 150 : 180
        int firstStrokeToDraw = math.max(0, strokeCountForDraw - strokeDrawBudget)
        for i = firstStrokeToDraw to strokeCountForDraw - 1
            Unit stroke = array.get(viewStrokes, i)
            if stroke.endIndex >= bar_index - detailBars and (stroke.confirmed or showCandidates)
                color strokeColor = stroke.confirmed ? (stroke.direction == 1 ? upColor : downColor) : candidateColor
                string strokeStyle = stroke.confirmed ? line.style_solid : line.style_dashed
                line strokeLine = line.new(stroke.startTime, stroke.startPrice, stroke.endTime, stroke.endPrice, xloc = xloc.bar_time, color = strokeColor, style = strokeStyle, width = stroke.confirmed ? 2 : 1)
                array.push(structureLines, strokeLine)

    int l1CountForDraw = array.size(segmentsS)
    if showSegments and l1CountForDraw > 0
        int l1DrawBudget = tradingView ? 18 : viewPreset == "简洁" ? 25 : viewPreset == "标准" ? 55 : 70
        int firstL1ToDraw = math.max(0, l1CountForDraw - l1DrawBudget)
        for i = firstL1ToDraw to l1CountForDraw - 1
            Unit segment = array.get(segmentsS, i)
            if segment.endIndex >= bar_index - detailBars and (segment.confirmed or showCandidates)
                color segmentColor = segment.confirmed ? layer1Color : candidateColor
                string segmentStyle = segment.confirmed ? line.style_solid : line.style_dashed
                line segmentLine = line.new(segment.startTime, segment.startPrice, segment.endTime, segment.endPrice, xloc = xloc.bar_time, color = segmentColor, style = segmentStyle, width = 3)
                array.push(structureLines, segmentLine)

    if showHigherSegments and (viewPreset == "研究" or tradingView)
        int l2CountForDraw = array.size(movementsT0)
        if l2CountForDraw > 0
            int firstL2ToDraw = math.max(0, l2CountForDraw - (tradingView ? 6 : 24))
            for i = firstL2ToDraw to l2CountForDraw - 1
                Unit segment = array.get(movementsT0, i)
                if segment.endIndex >= bar_index - detailBars and (segment.confirmed or showCandidates)
                    line segmentLine = line.new(segment.startTime, segment.startPrice, segment.endTime, segment.endPrice, xloc = xloc.bar_time, color = segment.confirmed ? layer2Color : candidateColor, style = segment.confirmed ? line.style_solid : line.style_dashed, width = 4)
                    array.push(structureLines, segmentLine)
        int l3CountForDraw = array.size(movementsT1)
        if not tradingView and l3CountForDraw > 0
            int firstL3ToDraw = math.max(0, l3CountForDraw - 8)
            for i = firstL3ToDraw to l3CountForDraw - 1
                Unit segment = array.get(movementsT1, i)
                if segment.endIndex >= bar_index - detailBars and (segment.confirmed or showCandidates)
                    line segmentLine = line.new(segment.startTime, segment.startPrice, segment.endTime, segment.endPrice, xloc = xloc.bar_time, color = segment.confirmed ? layer3Color : candidateColor, style = segment.confirmed ? line.style_solid : line.style_dashed, width = 5)
                    array.push(structureLines, segmentLine)

    int fractalCountForDraw = array.size(baseFractals)
    if showFractals and viewPreset == "研究" and fractalCountForDraw > 0
        int firstFractalToDraw = math.max(0, fractalCountForDraw - 50)
        for i = firstFractalToDraw to fractalCountForDraw - 1
            Fractal fractal = array.get(baseFractals, i)
            if fractal.structureIndex >= bar_index - detailBars
                string fractalText = fractal.kind == 1 ? "顶" : "底"
                label fractalLabel = label.new(fractal.structureIndex, fractal.price, fractalText, xloc = xloc.bar_index, style = fractal.kind == 1 ? label.style_label_down : label.style_label_up, color = color.new(fractal.kind == 1 ? downColor : upColor, 72), textcolor = foregroundColor, size = size.tiny)
                array.push(structureLabels, fractalLabel)

    int l0CenterDraw = not showCenters ? 0 : tradingView ? 2 : viewPreset == "简洁" ? 1 : viewPreset == "标准" ? 25 : 30
    int l1CenterDraw = not showCenters ? 0 : tradingView ? 2 : viewPreset == "简洁" ? 1 : viewPreset == "标准" ? 12 : 18
    int l2CenterDraw = not showCenters ? 0 : tradingView ? 1 : viewPreset == "简洁" ? 1 : viewPreset == "标准" ? 4 : 8
    int l3CenterDraw = not showCenters ? 0 : tradingView ? 0 : viewPreset == "简洁" ? 1 : viewPreset == "标准" ? 2 : 4
    bool showWaveCenters = viewPreset == "研究"
    f_draw_centers(centersT0, structureBoxes, structureLabels, foregroundColor, l0CenterDraw, detailBars, showWaveCenters)
    f_draw_centers(centersT1, structureBoxes, structureLabels, layer1Color, l1CenterDraw, detailBars, showWaveCenters)
    f_draw_centers(centersT2, structureBoxes, structureLabels, layer2Color, l2CenterDraw, detailBars, showWaveCenters)
    f_draw_centers(centersT3, structureBoxes, structureLabels, layer3Color, l3CenterDraw, detailBars, showWaveCenters)

    int divergenceDraw = not showDivergences ? 0 : tradingView ? 4 : viewPreset == "简洁" ? 1 : viewPreset == "标准" ? 10 : 12
    f_draw_divergences(divergencesT0, structureLabels, foregroundColor, divergenceDraw, detailBars, tradingView, tradingView)
    f_draw_divergences(divergencesT1, structureLabels, layer1Color, divergenceDraw, detailBars, tradingView, tradingView)
    f_draw_divergences(divergencesT2, structureLabels, layer2Color, divergenceDraw, detailBars, tradingView, tradingView)
    f_draw_divergences(divergencesT3, structureLabels, layer3Color, divergenceDraw, detailBars, tradingView, tradingView)

    int remainingPointBudget = (showBuySellPoints or showEvidenceRanges) ? pointRenderBudget : 0
    remainingPointBudget -= f_draw_points(pointsT3, structureLines, structureLabels, remainingPointBudget, detailBars, tradingView, showBuySellPoints, showEvidenceRanges, tradingView)
    remainingPointBudget -= f_draw_points(pointsT2, structureLines, structureLabels, remainingPointBudget, detailBars, tradingView, showBuySellPoints, showEvidenceRanges, tradingView)
    remainingPointBudget -= f_draw_points(pointsT1, structureLines, structureLabels, remainingPointBudget, detailBars, tradingView, showBuySellPoints, showEvidenceRanges, tradingView)
    remainingPointBudget -= f_draw_points(pointsT0, structureLines, structureLabels, remainingPointBudget, detailBars, tradingView, showBuySellPoints, showEvidenceRanges, tradingView)
    f_draw_scenarios(activeScenarios, structureLines, structureLabels)

f_panel_cell(table panel, int column, int row, string cellText, color text_color, color bgcolor = na, string tooltip = "") =>
    table.cell(panel, column, row, cellText, text_color = text_color, bgcolor = bgcolor, text_size = size.tiny, tooltip = tooltip)

var table statusPanel = table.new(position.top_right, 2, 42, border_width = 1)

if barstate.islast
    f_panel_cell(statusPanel, 0, 0, "严格递归缠论", bgcolor = color.new(foregroundColor, 85), text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 0, "Pine v6", bgcolor = color.new(foregroundColor, 85), text_color = foregroundColor)
    f_panel_cell(statusPanel, 0, 1, "焦点周期", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 1, timeframe.period, text_color = foregroundColor)
    f_panel_cell(statusPanel, 0, 2, "图表", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 2, standardChart ? "标准 K 线" : "不支持的合成图表", text_color = standardChart ? foregroundColor : warningColor)
    f_panel_cell(statusPanel, 0, 3, "理论版本", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 3, THEORY_VERSION, text_color = foregroundColor)
    f_panel_cell(statusPanel, 0, 4, "预热", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 4, warmedUp ? "完成" : str.tostring(bar_index + 1) + "/" + str.tostring(warmupBars), text_color = warmedUp ? foregroundColor : warningColor)
    f_panel_cell(statusPanel, 0, 5, "合成 K 线", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 5, str.tostring(array.size(syntheticBars)), text_color = foregroundColor)
    f_panel_cell(statusPanel, 0, 6, "基础分型", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 6, str.tostring(array.size(baseFractals)), text_color = foregroundColor)
    f_panel_cell(statusPanel, 0, 7, "B 笔", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 7, str.tostring(array.size(viewStrokes)), text_color = foregroundColor)
    f_panel_cell(statusPanel, 0, 8, "确认 / 候选", text_color = foregroundColor)
    int totalStrokes = array.size(viewStrokes)
    int confirmedStrokes = totalStrokes > 0 and not array.get(viewStrokes, totalStrokes - 1).confirmed ? totalStrokes - 1 : totalStrokes
    f_panel_cell(statusPanel, 1, 8, str.tostring(math.max(0, confirmedStrokes)) + " / " + str.tostring(totalStrokes - math.max(0, confirmedStrokes)), text_color = foregroundColor)
    f_panel_cell(statusPanel, 0, 9, "S 线段", text_color = foregroundColor)
    int totalL1 = array.size(segmentsS)
    int confirmedL1 = totalL1 > 0 and not array.get(segmentsS, totalL1 - 1).confirmed ? totalL1 - 1 : totalL1
    f_panel_cell(statusPanel, 1, 9, str.tostring(math.max(0, confirmedL1)) + " / " + str.tostring(totalL1 - math.max(0, confirmedL1)), text_color = layer1Color)
    f_panel_cell(statusPanel, 0, 10, "T0 完成走势", text_color = foregroundColor)
    int totalL2 = array.size(movementsT0)
    int confirmedL2 = totalL2 > 0 and not array.get(movementsT0, totalL2 - 1).confirmed ? totalL2 - 1 : totalL2
    f_panel_cell(statusPanel, 1, 10, str.tostring(math.max(0, confirmedL2)) + " / " + str.tostring(totalL2 - math.max(0, confirmedL2)), text_color = layer2Color)
    f_panel_cell(statusPanel, 0, 11, "T1 完成走势", text_color = foregroundColor)
    int totalL3 = array.size(movementsT1)
    int confirmedL3 = totalL3 > 0 and not array.get(movementsT1, totalL3 - 1).confirmed ? totalL3 - 1 : totalL3
    f_panel_cell(statusPanel, 1, 11, str.tostring(math.max(0, confirmedL3)) + " / " + str.tostring(totalL3 - math.max(0, confirmedL3)), text_color = layer3Color)
    f_panel_cell(statusPanel, 0, 12, "最高有效级别", text_color = foregroundColor)
    string highestLayer = array.size(centersT3) > 0 ? "T3" : array.size(centersT2) > 0 ? "T2" : array.size(centersT1) > 0 ? "T1" : array.size(centersT0) > 0 ? "T0" : totalL1 > 0 ? "S" : totalStrokes > 0 ? "B" : "K"
    f_panel_cell(statusPanel, 1, 12, highestLayer, text_color = foregroundColor)
    f_panel_cell(statusPanel, 0, 13, "T0 中枢", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 13, f_center_summary(centersT0), text_color = foregroundColor)
    f_panel_cell(statusPanel, 0, 14, "T1 中枢", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 14, f_center_summary(centersT1), text_color = layer1Color)
    f_panel_cell(statusPanel, 0, 15, "T2 中枢", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 15, f_center_summary(centersT2), text_color = layer2Color)
    f_panel_cell(statusPanel, 0, 16, "T3 中枢", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 16, f_center_summary(centersT3), text_color = layer3Color)
    f_panel_cell(statusPanel, 0, 17, "T0 走势", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 17, f_trend_summary(trendT0), text_color = foregroundColor)
    f_panel_cell(statusPanel, 0, 18, "T1 走势", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 18, f_trend_summary(trendT1), text_color = layer1Color)
    f_panel_cell(statusPanel, 0, 19, "T2 走势", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 19, f_trend_summary(trendT2), text_color = layer2Color)
    f_panel_cell(statusPanel, 0, 20, "T3 走势", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 20, f_trend_summary(trendT3), text_color = layer3Color)
    f_panel_cell(statusPanel, 0, 21, "T0 背驰", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 21, f_divergence_summary(divergencesT0), text_color = foregroundColor)
    f_panel_cell(statusPanel, 0, 22, "T1 背驰", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 22, f_divergence_summary(divergencesT1), text_color = layer1Color)
    f_panel_cell(statusPanel, 0, 23, "T2 背驰", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 23, f_divergence_summary(divergencesT2), text_color = layer2Color)
    f_panel_cell(statusPanel, 0, 24, "T3 背驰", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 24, f_divergence_summary(divergencesT3), text_color = layer3Color)
    f_panel_cell(statusPanel, 0, 25, "T0 买卖点", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 25, f_point_summary(pointsT0), text_color = foregroundColor)
    f_panel_cell(statusPanel, 0, 26, "T1/T2/T3 点 1/2/3", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 26, f_point_triplet(pointsT1) + " | " + f_point_triplet(pointsT2) + " | " + f_point_triplet(pointsT3), text_color = layer1Color)
    f_panel_cell(statusPanel, 0, 27, "参考/窗口/递归", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 27, str.tostring(activeReferenceCount) + "/4 · " + str.tostring(detailBars) + " K · T0-T3", text_color = foregroundColor)
    f_panel_cell(statusPanel, 0, 28, "对象 线/框/标", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 28, str.tostring(array.size(structureLines)) + "/" + str.tostring(array.size(structureBoxes)) + "/" + str.tostring(array.size(structureLabels)), text_color = foregroundColor)
    f_panel_cell(statusPanel, 0, 29, "活动结构 / 历史事件", text_color = foregroundColor)
    string engineStatus = not standardChart ? "确认/参考均已停止" : barstate.isconfirmed ? "收盘确认状态" : "活动K候选预览·确认冻结"
    f_panel_cell(statusPanel, 1, 29, str.tostring(array.size(currentStructureSnapshots)) + " / " + str.tostring(array.size(lifecycleEvents)) + " · " + engineStatus, text_color = standardChart ? foregroundColor : warningColor)
    f_panel_cell(statusPanel, 0, 30, "参考 1", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 30, f_reference_summary(referenceRequested1, referenceEnabled1, referenceTimeframe1, referenceEngine1), text_color = layer1Color)
    f_panel_cell(statusPanel, 0, 31, "参考 2", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 31, f_reference_summary(referenceRequested2, referenceEnabled2, referenceTimeframe2, referenceEngine2), text_color = layer1Color)
    f_panel_cell(statusPanel, 0, 32, "参考 3", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 32, f_reference_summary(referenceRequested3, referenceEnabled3, referenceTimeframe3, referenceEngine3), text_color = layer1Color)
    f_panel_cell(statusPanel, 0, 33, "参考 4", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 33, f_reference_summary(referenceRequested4, referenceEnabled4, referenceTimeframe4, referenceEngine4), text_color = layer1Color)
    f_panel_cell(statusPanel, 0, 34, "活动证据", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 34, f_evidence_summary(activeEvidence), text_color = foregroundColor)
    f_panel_cell(statusPanel, 0, 35, "层间共振", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 35, f_resonance_summary(activeResonances, 1), text_color = layer2Color, tooltip = f_resonance_tooltip(activeResonances, 1))
    f_panel_cell(statusPanel, 0, 36, "跨周期共振", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 36, f_resonance_summary(activeResonances, 2), text_color = layer2Color, tooltip = f_resonance_tooltip(activeResonances, 2))
    f_panel_cell(statusPanel, 0, 37, "区间套", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 37, f_nesting_summary(nestingState), text_color = layer3Color, tooltip = f_nesting_tooltip(nestingState))
    f_panel_cell(statusPanel, 0, 38, "终完美情景", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 38, f_scenario_summary(activeScenarios), text_color = candidateColor, tooltip = f_scenario_tooltip(activeScenarios))
    string dataDate = na(dataStartTime) ? "未知" : str.format_time(dataStartTime, "yyyy-MM-dd")
    string reliableDate = na(reliableStartTime) ? "等待完整结构" : str.format_time(reliableStartTime, "yyyy-MM-dd")
    f_panel_cell(statusPanel, 0, 39, "数据/可靠起点", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 39, dataDate + " / " + reliableDate, text_color = na(reliableStartTime) ? warningColor : foregroundColor)
    int drawStartTime = bar_index >= detailBars ? time[detailBars] : dataStartTime
    bool detailedHistoryTruncated = array.size(viewStrokes) > 0 and array.get(viewStrokes, 0).endIndex < bar_index - detailBars
    f_panel_cell(statusPanel, 0, 40, "详细绘图范围", text_color = foregroundColor)
    f_panel_cell(statusPanel, 1, 40, (na(drawStartTime) ? "未知" : str.format_time(drawStartTime, "yyyy-MM-dd")) + (detailedHistoryTruncated ? "·旧几何已裁剪" : "·全可见"), text_color = detailedHistoryTruncated ? warningColor : foregroundColor)
    bool nearObjectLimit = array.size(structureLines) >= 450 or array.size(structureBoxes) >= 450 or array.size(structureLabels) >= 450
    bool resourceClipped = nearObjectLimit or pointHistoryClipped
    f_panel_cell(statusPanel, 0, 41, "计算/资源", text_color = foregroundColor)
    string resourceStatus = pointHistoryClipped ? "历史点预算裁剪" : nearObjectLimit ? "几何已主动裁剪" : "预算正常"
    f_panel_cell(statusPanel, 1, 41, "焦T0-3·参T0-2·" + resourceStatus, text_color = resourceClipped ? warningColor : foregroundColor)

    if not showStatusPanel
        table.clear(statusPanel, 0, 0, 1, 41)
    else if tradingView
        table.clear(statusPanel, 0, 0, 1, 41)
        [tradeSignalText, tradeSignalDirection, tradeSignalConfirmed] = f_trade_signal_summary(activeEvidence)
        color tradeSignalColor = tradeSignalDirection == 1 ? upColor : tradeSignalDirection == -1 ? downColor : foregroundColor
        f_panel_cell(statusPanel, 0, 0, "交易视图", bgcolor = color.new(foregroundColor, 85), text_color = foregroundColor)
        f_panel_cell(statusPanel, 1, 0, timeframe.period + "·" + THEORY_VERSION, bgcolor = color.new(foregroundColor, 85), text_color = foregroundColor)
        f_panel_cell(statusPanel, 0, 1, "当前信号", text_color = foregroundColor)
        f_panel_cell(statusPanel, 1, 1, tradeSignalText, text_color = tradeSignalConfirmed ? tradeSignalColor : candidateColor)
        f_panel_cell(statusPanel, 0, 2, "T0 / T1 走势", text_color = foregroundColor)
        f_panel_cell(statusPanel, 1, 2, f_trend_summary(trendT0) + " | " + f_trend_summary(trendT1), text_color = layer1Color)
        f_panel_cell(statusPanel, 0, 3, "层间 / 跨周期", text_color = foregroundColor)
        f_panel_cell(statusPanel, 1, 3, f_resonance_summary(activeResonances, 1) + " | " + f_resonance_summary(activeResonances, 2), text_color = layer2Color)
        f_panel_cell(statusPanel, 0, 4, "区间套", text_color = foregroundColor)
        f_panel_cell(statusPanel, 1, 4, f_nesting_summary(nestingState), text_color = layer3Color, tooltip = f_nesting_tooltip(nestingState))
        f_panel_cell(statusPanel, 0, 5, "活动证据", text_color = foregroundColor)
        f_panel_cell(statusPanel, 1, 5, f_evidence_summary(activeEvidence), text_color = foregroundColor)
        f_panel_cell(statusPanel, 0, 6, "参考周期", text_color = foregroundColor)
        f_panel_cell(statusPanel, 1, 6, str.tostring(activeReferenceCount) + "/4 已确认", text_color = foregroundColor)
        f_panel_cell(statusPanel, 0, 7, "可靠起点", text_color = foregroundColor)
        f_panel_cell(statusPanel, 1, 7, reliableDate, text_color = na(reliableStartTime) ? warningColor : foregroundColor)
        f_panel_cell(statusPanel, 0, 8, "计算 / 资源", text_color = foregroundColor)
        f_panel_cell(statusPanel, 1, 8, highestLayer + "·" + resourceStatus, text_color = resourceClipped ? warningColor : foregroundColor)

plot(normalizedClose, "标准价格锚", color = color.new(foregroundColor, 100), display = display.none)
