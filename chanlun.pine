int MOVEMENT_COMPLETION_CANDIDATE = 2
int MOVEMENT_COMPLETED = 3
int MOVEMENT_COMPLETED_BY_REVERSE = 1
int MOVEMENT_COMPLETED_BY_PROMOTION = 2

