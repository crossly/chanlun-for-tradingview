indicator(
     "严格递归缠论",
     shorttitle = "缠论递归",
     overlay = true,
     max_bars_back = 5000,
    max_lines_count = 500,
    max_labels_count = 500,
    max_boxes_count = 500,
    max_polylines_count = 100,
    behind_chart = false,
    dynamic_requests = true)

// Theoretical settings are intentionally fixed. Only the accepted stroke
// definition and presentation/integration settings are configurable.
string GROUP_THEORY = "理论口径"
string GROUP_VIEW = "显示预设"
string GROUP_DISPLAY = "显示开关"
string GROUP_REFERENCE = "参考周期"
string GROUP_ALERT = "提醒"
int MACD_WARMUP_BARS = 200

string strokeMode = input.string("修订笔", "笔口径", options = ["修订笔", "严格笔"], group = GROUP_THEORY)
string viewPreset = input.string("标准", "显示预设", options = ["交易", "简洁", "标准", "研究"], group = GROUP_VIEW)
string colorTheme = input.string("TradingView", "颜色主题", options = ["TradingView", "中国市场", "色觉友好"], group = GROUP_VIEW)
int detailBars = input.int(2000, "详细绘图窗口", minval = 300, maxval = 5000, step = 100, group = GROUP_VIEW)

bool showCandidates = input.bool(true, "候选结构", group = GROUP_DISPLAY, inline = "state")
bool showScenarios = input.bool(true, "情景推演", group = GROUP_DISPLAY, inline = "state")
bool showFractals = input.bool(true, "基础分型", group = GROUP_DISPLAY, inline = "unit")
bool showStrokes = input.bool(true, "笔", group = GROUP_DISPLAY, inline = "unit")
bool showSegments = input.bool(true, "线段", group = GROUP_DISPLAY, inline = "segment")
bool showHigherSegments = input.bool(true, "高阶线段", group = GROUP_DISPLAY, inline = "segment")
bool showCenters = input.bool(true, "中枢", group = GROUP_DISPLAY, inline = "signal")
bool showDivergences = input.bool(true, "背驰", group = GROUP_DISPLAY, inline = "signal")
bool showBuySellPoints = input.bool(true, "买卖点", group = GROUP_DISPLAY, inline = "point")
bool showEvidenceRanges = input.bool(true, "失效边界", group = GROUP_DISPLAY, inline = "point")
bool showStatusPanel = input.bool(true, "状态面板", group = GROUP_DISPLAY)

bool useAutoReferences = input.bool(true, "自动参考周期", group = GROUP_REFERENCE)
int referenceCount = input.int(4, "参考周期数量", minval = 0, maxval = 4, group = GROUP_REFERENCE)
string manualReference1 = input.timeframe("60", "手动周期 1", group = GROUP_REFERENCE)
string manualReference2 = input.timeframe("240", "手动周期 2", group = GROUP_REFERENCE)
string manualReference3 = input.timeframe("1D", "手动周期 3", group = GROUP_REFERENCE)
string manualReference4 = input.timeframe("1W", "手动周期 4", group = GROUP_REFERENCE)

bool alertBuySell = input.bool(true, "买卖点", group = GROUP_ALERT)
bool alertDivergence = input.bool(true, "背驰", group = GROUP_ALERT)
bool alertResonance = input.bool(true, "共振", group = GROUP_ALERT)
bool alertNesting = input.bool(true, "区间套", group = GROUP_ALERT)
bool alertScenario = input.bool(false, "情景事件", group = GROUP_ALERT)
bool alertCandidates = input.bool(false, "候选事件", group = GROUP_ALERT)

// -----------------------------------------------------------------------------
// Core structure types
// -----------------------------------------------------------------------------

type KBar
    int startIndex
    int endIndex
    int startTime
    int endTime
    float high
    float low
    int highIndex
    int lowIndex
    int highTime
    int lowTime
    int direction

type Fractal
    int kind
    int kPosition
    int structureIndex
    int structureTime
    int confirmationTime
    float price

type Unit
    int layer
    int direction
    int startIndex
    int endIndex
    int startTime
    int endTime
    int confirmationTime
    float startPrice
    float endPrice
    bool confirmed
    int firstChild
    int lastChild
    float macdArea
    float difExtreme

type Feature
    int firstChild
    int lastChild
    float high
    float low
    int highIndex
    int lowIndex
    int highTime
    int lowTime
    int highChild
    int lowChild
    int direction

type Center
    int layer
    int startChild
    int lastOverlapChild
    int endChild
    int startIndex
    int endIndex
    int startTime
    int endTime
    int confirmationTime
    int departureConfirmationTime
    float zd
    float zg
    float dd
    float gg
    bool confirmed
    bool stateConfirmed
    int leaveState
    int leaveDirection
    int leaveChild
    int retestChild
    bool failedDeparture
    bool expansionCandidate
    bool expansionConfirmed
    int parentCenter
    int promotionSourceFirst
    int promotionSourceSecond
    int promotionSourceThird

type TrendState
    int layer
    int kind
    int direction
    int centerCount
    int firstCenter
    int lastCenter
    bool confirmed
    bool completionCandidate

type Divergence
    int layer
    int kind
    int direction
    int centerIndex
    int trendCenterCount
    int enteringUnit
    int leavingUnit
    int structureIndex
    int structureTime
    int confirmationTime
    int firstKnownTime
    float structurePrice
    float confirmationPrice
    bool confirmed
    float areaRatio
    float enteringArea
    float leavingArea
    bool difWeaker
    bool valid
    bool invalidationCandidate
    float invalidationPrice
    int evidenceStartTime
    int evidenceEndTime
    int parentStartTime
    int parentEndTime

type BuySellPoint
    int layer
    int pointClass
    int direction
    int sourceDivergence
    int sourceCenter
    int linkedFirstPoint
    int structureUnit
    int proofUnit
    int structureIndex
    int structureTime
    int confirmationTime
    int firstKnownTime
    float structurePrice
    float confirmationPrice
    int confirmationDelayBars
    bool confirmed
    bool valid
    bool invalidationCandidate
    float invalidationPrice
    int evidenceStartIndex
    int evidenceStartTime
    int evidenceEndIndex
    int evidenceEndTime

type Evidence
    int market
    string marketTimeframe
    int layer
    int kind
    int direction
    bool confirmed
    bool invalidationCandidate
    int sourceIndex
    int structureStartTime
    int structureTime
    int confirmationTime
    int knownTime
    int evidenceStartTime
    int evidenceEndTime
