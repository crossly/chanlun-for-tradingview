     "严格递归缠论 course-v2",
     shorttitle = "缠论 course-v2",
     overlay = true,
     max_bars_back = 5000,
    max_lines_count = 500,
    max_labels_count = 500,
    max_boxes_count = 500,
    max_polylines_count = 100,
    behind_chart = false,
    dynamic_requests = true)

